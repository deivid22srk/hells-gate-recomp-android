   // System shader constants.
   SpirvShaderTranslator::SystemConstants system_constants_;
 
   // Temporary storage for memexport stream constants used in the draw.
   std::vector<draw_util::MemExportRange> memexport_ranges_;
+
+  // [Android AAA perf] Coalesced conservative memexport invalidation state:
+  // set by draws with unresolved memexport destinations, flushed once in
+  // EndSubmission (see IssueDraw and the
+  // vulkan_memexport_invalidate_per_draw cvar).
+  bool conservative_memexport_invalidation_pending_ = false;
+  uint32_t conservative_memexport_invalidation_draws_ = 0;
 };
 
 }  // namespace rex::graphics::vulkan
