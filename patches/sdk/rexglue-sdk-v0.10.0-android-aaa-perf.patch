diff -ruN '--exclude=thirdparty' a/include/rex/graphics/vulkan/bc_transcoder.h b/include/rex/graphics/vulkan/bc_transcoder.h
--- a/include/rex/graphics/vulkan/bc_transcoder.h	1970-01-01 00:00:00.000000000 +0000
+++ b/include/rex/graphics/vulkan/bc_transcoder.h	2026-09-07 23:50:46.000000000 +0000
@@ -0,0 +1,118 @@
+/**
+ * @file        bc_transcoder.h
+ * @brief       CPU-side BCn (S3TC) -> ASTC/ETC2/EAC block transcoding
+ *
+ * @copyright   Copyright (c) 2026
+ *              All rights reserved.
+ *
+ * @license     BSD 3-Clause License (ReXGlue SDK derivative work)
+ *
+ * [Android AAA perf] On mobile GPUs whose Vulkan drivers do not expose the
+ * BC1-BC5 (S3TC) formats with sampling support (e.g. Adreno 619-class
+ * devices with older driver packages - documented in the Dante's Inferno
+ * Android port's performance logs), the texture cache falls back to
+ * decompressing every BCn texture to RGBA8 at upload time: 4x the memory,
+ * 4x the sampling bandwidth, plus a compute decode pass on every
+ * invalidation. This transcoder converts the guest BCn blocks, once per
+ * texture version on the CPU, into GPU-native compressed formats that are
+ * universally supported on mobile Vulkan devices:
+ *
+ *   DXT1/DXT1_AS_16_16_16_16  -> ASTC 4x4 (16 B/block, near lossless)
+ *                                 Clean (4-color) blocks: CEM 12 (LDR RGBA
+ *                                 direct), single plane, 2-bit weights -
+ *                                 endpoint colors are exact RGB565->RGB888
+ *                                 expansions and the weight grid reproduces
+ *                                 the BC1 ramp {0, 1/3, 2/3, 1} to within
+ *                                 1 LSB per channel.
+ *                                 Punchthrough (3-color) blocks: dual-plane
+ *                                 CEM 12 with 1-bit weights - alpha is exact
+ *                                 {0, 255}, endpoint colors are exact; the
+ *                                 1/2 blend level and transparent-texel RGB
+ *                                 carry a small, alpha-masked error.
+ *   DXT2_3 / DXT4_5           -> ETC2 RGBA8 (16 B/block) - EAC alpha fits
+ *                                 the BC2/BC3 alpha samples, an ETC2
+ *                                 differential-mode encoder fits the RGB
+ *                                 samples.
+ *   DXT5A                     -> EAC R11 (8 B/block).
+ *   DXN (BC5)                 -> EAC RG11 (16 B/block).
+ *
+ * All encoders are deterministic and allocation-free. The public entry
+ * points operate on single guest blocks (post endian-swap) so the caller
+ * controls mip/array/tile layout via its own iteration.
+ */
+
+#pragma once
+
+#include <cstdint>
+
+#include <rex/graphics/pipeline/texture/info.h>
+#include <rex/graphics/xenos.h>
+
+namespace rex::graphics::vulkan::bc_transcode {
+
+// Target compressed format for one guest BCn format. kNone means "no
+// transcoder available for this guest format" (the caller keeps the
+// decompress-to-RGBA8 compute path).
+enum class TargetFormat : uint32_t {
+  kNone = 0,
+  kASTC4x4,    // 16 bytes per block
+  kETC2RGBA8,  // 16 bytes per block
+  kEACR11,     // 8 bytes per block
+  kEACRG11,    // 16 bytes per block
+};
+
+inline constexpr uint32_t kTargetBlockWidth = 4;
+inline constexpr uint32_t kTargetBlockHeight = 4;
+
+inline constexpr uint32_t TargetBytesPerBlock(TargetFormat format) {
+  switch (format) {
+    case TargetFormat::kASTC4x4:
+    case TargetFormat::kETC2RGBA8:
+    case TargetFormat::kEACRG11:
+      return 16;
+    case TargetFormat::kEACR11:
+      return 8;
+    default:
+      return 0;
+  }
+}
+
+// Which target format the given guest texture format transcodes to.
+// kNone for non-BCn formats.
+TargetFormat GetTargetFormat(xenos::TextureFormat guest_format);
+
+// One guest block (2 dwords, host byte order, AFTER xenos::Endian swapping
+// has been applied by the caller) -> one 16-byte ASTC 4x4 block (DXT1, with
+// per-block punchthrough handling) or 16-byte ETC2 RGBA8 block /
+// 8-or-16-byte EAC block.
+void TranscodeDXT1BlockToASTC(uint64_t block, uint8_t* out);
+void TranscodeDXT23BlockToETC2RGBA(uint64_t rgb_block, uint64_t alpha_block, uint8_t* out);
+void TranscodeDXT45BlockToETC2RGBA(uint64_t rgb_block, uint64_t alpha_block, uint8_t* out);
+void TranscodeDXT5ABlockToEACR11(uint64_t block, uint8_t* out);
+void TranscodeDXNBlockToEACRG11(uint64_t red_block, uint64_t green_block, uint8_t* out);
+
+// Byte-swapping helper mirroring what the texture load shaders do to guest
+// blocks before decompression (same semantics as texture_util CopySwapBlock,
+// inlined here so the transcode hot loop has no call overhead). Swapping is
+// applied per element and the element order is preserved.
+inline uint32_t BSwap32(uint32_t v) { return __builtin_bswap32(v); }
+
+inline uint64_t SwapGuestBlock64(uint64_t block, xenos::Endian endian) {
+  const uint32_t lo = uint32_t(block & 0xFFFFFFFFull);
+  const uint32_t hi = uint32_t(block >> 32);
+  switch (endian) {
+    case xenos::Endian::k8in32:
+      return (uint64_t(BSwap32(hi)) << 32) | BSwap32(lo);
+    case xenos::Endian::k16in32:
+      // Swap the two 16-bit halves within each 32-bit word.
+      return (uint64_t((hi >> 16) | (hi << 16)) << 32) | ((lo >> 16) | (lo << 16));
+    case xenos::Endian::k8in16: {
+      // Swap the two bytes within each 16-bit halfword.
+      return ((block & 0x00FF00FF00FF00FFull) << 8) | ((block >> 8) & 0x00FF00FF00FF00FFull);
+    }
+    default:
+      return block;
+  }
+}
+
+}  // namespace rex::graphics::vulkan::bc_transcode
