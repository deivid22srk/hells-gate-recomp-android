+// [Android AAA perf] CPU topology detection + current-thread affinity/priority
+// helpers (see include/rex/thread.h). Implemented here for all Linux/Android
+// hosts; macOS keeps no-op semantics because it exposes no sched_setaffinity.
+namespace {
+
+struct CpuTopology {
+  bool valid = false;
+  uint64_t performance_mask = 0;
+  uint64_t efficiency_mask = 0;
+  uint32_t core_count = 0;
+};
+
+CpuTopology DetectCpuTopology() {
+  CpuTopology topology;
+#if !defined(__APPLE__)
+  // Enumerate the present CPUs ("0-7" or "0,2,4").
+  std::FILE* present = std::fopen("/sys/devices/system/cpu/present", "r");
+  if (!present) {
+    return topology;
+  }
+  std::vector<uint32_t> cpus;
+  {
+    char list[192] = {};
+    const size_t length = std::fread(list, 1, sizeof(list) - 1, present);
+    std::fclose(present);
+    list[length] = 0;
+    uint32_t value = 0;
+    bool have_value = false;
+    uint32_t range_start = 0;
+    const auto flush_value = [&]() {
+      if (have_value) {
+        if (range_start != UINT32_MAX) {
+          for (uint32_t cpu = range_start; cpu <= value; ++cpu) {
+            cpus.push_back(cpu);
+          }
+          range_start = UINT32_MAX;
+        } else {
+          cpus.push_back(value);
+        }
+        have_value = false;
+      }
+    };
+    for (const char* c = list; *c; ++c) {
+      if (*c >= '0' && *c <= '9') {
+        value = value * 10 + uint32_t(*c - '0');
+        have_value = true;
+      } else if (*c == '-') {
+        range_start = have_value ? value : UINT32_MAX;
+        value = 0;
+        have_value = false;
+      } else {
+        flush_value();
+        value = 0;
+        have_value = false;
+        if (*c != ',') {
+          break;
+        }
+      }
+    }
+    flush_value();
+  }
+  topology.core_count = uint32_t(cpus.size());
+  if (cpus.size() < 2) {
+    return topology;
+  }
+
+  // Read the maximum frequency of each core and split the clusters at the
+  // frequency median. Homogeneous parts get no pinning at all (valid stays
+  // false) - the scheduler is already doing the right thing there.
+  std::vector<uint32_t> freqs;
+  freqs.reserve(cpus.size());
+  for (uint32_t cpu : cpus) {
+    char path[64];
+    std::snprintf(path, sizeof(path), "/sys/devices/system/cpu/cpu%u/cpufreq/cpuinfo_max_freq",
+                  cpu);
+    std::FILE* freq_file = std::fopen(path, "r");
+    if (!freq_file) {
+      // Missing cpufreq (some emulators/containers): no topology knowledge.
+      return topology;
+    }
+    uint32_t khz = 0;
+    const int scanned = std::fscanf(freq_file, "%u", &khz);
+    std::fclose(freq_file);
+    if (scanned != 1 || khz == 0) {
+      return topology;
+    }
+    freqs.push_back(khz);
+  }
+  std::vector<uint32_t> sorted = freqs;
+  std::sort(sorted.begin(), sorted.end());
+  if (sorted.front() == sorted.back()) {
+    return topology;
+  }
+  const uint32_t threshold = sorted[sorted.size() / 2];
+  for (size_t i = 0; i < cpus.size(); ++i) {
+    if (freqs[i] > threshold) {
+      topology.performance_mask |= uint64_t(1) << cpus[i];
+    } else {
+      topology.efficiency_mask |= uint64_t(1) << cpus[i];
+    }
+  }
+  topology.valid = topology.performance_mask != 0 && topology.efficiency_mask != 0;
+#endif  // !__APPLE__
+  return topology;
+}
+
+const CpuTopology& GetCpuTopology() {
+  static const CpuTopology topology = DetectCpuTopology();
+  return topology;
+}
+
+bool PinCurrentThreadToMask(uint64_t mask) {
+  if (!mask) {
+    return false;
+  }
+#if defined(__APPLE__)
+  return false;
+#else
+  cpu_set_t cpu_set;
+  CPU_ZERO(&cpu_set);
+  for (uint32_t i = 0; i < 64; ++i) {
+    if (mask & (uint64_t(1) << i)) {
+      CPU_SET(i, &cpu_set);
+    }
+  }
+  return sched_setaffinity(0, sizeof(cpu_set), &cpu_set) == 0;
+#endif
+}
+
+}  // namespace
+
+bool PinCurrentThreadToPerformanceCores() {
+  const CpuTopology& topology = GetCpuTopology();
+  if (!topology.valid) {
+    return false;
+  }
+  return PinCurrentThreadToMask(topology.performance_mask);
+}
+
+bool PinCurrentThreadToEfficiencyCores() {
+  const CpuTopology& topology = GetCpuTopology();
+  if (!topology.valid) {
+    return false;
+  }
+  return PinCurrentThreadToMask(topology.efficiency_mask);
+}
+
+bool DemoteCurrentThreadPriority() {
+#if defined(__APPLE__)
+  return setpriority(PRIO_PROCESS, 0, 10) == 0;
+#else
+  // Linux/Android nice values are per-thread; who=0 refers to the calling
+  // thread. Unprivileged callers may only lower priority, so failure is
+  // harmless (we stay at the default nice 0).
+  return setpriority(PRIO_PROCESS, 0, 10) == 0;
+#endif
+}
+
