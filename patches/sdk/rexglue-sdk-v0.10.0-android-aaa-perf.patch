+
+TargetFormat GetTargetFormat(xenos::TextureFormat guest_format) {
+  switch (guest_format) {
+    case xenos::TextureFormat::k_DXT1:
+    case xenos::TextureFormat::k_DXT1_AS_16_16_16_16:
+      return TargetFormat::kASTC4x4;
+    case xenos::TextureFormat::k_DXT2_3:
+    case xenos::TextureFormat::k_DXT2_3_AS_16_16_16_16:
+    case xenos::TextureFormat::k_DXT4_5:
+    case xenos::TextureFormat::k_DXT4_5_AS_16_16_16_16:
+      return TargetFormat::kETC2RGBA8;
+    case xenos::TextureFormat::k_DXT5A:
+      return TargetFormat::kEACR11;
+    case xenos::TextureFormat::k_DXN:
+      return TargetFormat::kEACRG11;
+    default:
+      return TargetFormat::kNone;
+  }
+}
+
+void TranscodeDXT1BlockToASTC(uint64_t block, uint8_t* out) {
+  std::memset(out, 0, 16);
+  const DXT1ColorBlock color = DecodeDXT1Color(block);
+
+  if (!color.punchthrough) {
+    // ---- Clean (4-color) block: single plane, 2-bit weights. ----
+    ASTCEndpoints endpoints;
+    endpoints.e0[0] = color.c0.r;
+    endpoints.e0[1] = color.c0.g;
+    endpoints.e0[2] = color.c0.b;
+    endpoints.e0[3] = 255;
+    endpoints.e1[0] = color.c1.r;
+    endpoints.e1[1] = color.c1.g;
+    endpoints.e1[2] = color.c1.b;
+    endpoints.e1[3] = 255;
+    bool invert = false;
+    if (int32_t(RGBSum(endpoints.e1)) < int32_t(RGBSum(endpoints.e0))) {
+      // Keep s1 >= s0 so the decoder does not blue-contract (the transform
+      // is lossless: swap endpoints and invert every weight).
+      std::swap(endpoints.e0, endpoints.e1);
+      invert = true;
+    }
+    ASTCPackHeader(out, kASTCBlockMode2Bit, 12);
+    ASTCPackEndpointsCEM12(out, endpoints);
+    // Weight level for BC1 index i: 0 -> {0}, 1 -> {21}, 2 -> {43}, 3 -> {64},
+    // i.e. level == index. Inversion maps level l -> 64 - l == {64,43,21,0}
+    // == index {3, 2, 1, 0}.
+    for (uint32_t i = 0; i < 16; ++i) {
+      uint32_t weight = color.indices[i];
+      if (invert) {
+        weight = 3 - weight;
+      }
+      ASTCPackWeight(out, 2 * i, weight, 2);
+    }
+    return;
+  }
+
+  // ---- Punchthrough (3-color + transparent) block: dual plane, 1-bit
+  // weights. Plane 0 = RGB, plane 1 = alpha ({255, 0}).
+  // Index semantics: 0 -> (c0, 255), 1 -> (c1, 255), 2 -> ((c0+c1)/2, 255),
+  // 3 -> (black, 0).
+  //
+  // 1-bit RGB weights give two levels for the three visible colors
+  // {c0, c1, mid}. Instead of snapping the mid color to an endpoint
+  // (error |c0-c1|/2), use a 2-level quantizer: group {c0, mid} vs {c1}
+  // (or the symmetric split), making the per-texel error |c0-c1|/4.
+  // Candidates are scored against the actual texel population.
+  {
+    RGB8 mid_color = RGB8{uint8_t((uint32_t(color.c0.r) + uint32_t(color.c1.r) + 1) >> 1),
+                          uint8_t((uint32_t(color.c0.g) + uint32_t(color.c1.g) + 1) >> 1),
+                          uint8_t((uint32_t(color.c0.b) + uint32_t(color.c1.b) + 1) >> 1)};
+
+    // Candidate RGB level assignments for the visible indices:
+    // 0: levels = (c0, c1)             - mid snaps to an endpoint
+    // 1: levels = ((c0+mid)/2, c1)     - {i0, i2} -> level 0
+    // 2: levels = (c0, (c1+mid)/2)     - {i1, i2} -> level 1
+    struct Levels {
+      RGB8 level0, level1;
+      uint8_t mid_bit;  // 1-bit weight of the mid color (i2)
+    };
+    const auto lerp8 = [](uint32_t a, uint32_t b) { return uint8_t((a + b + 1) >> 1); };
+    const Levels candidates[3] = {
+        Levels{color.c0, color.c1, 0},
+        Levels{RGB8{lerp8(color.c0.r, mid_color.r), lerp8(color.c0.g, mid_color.g),
+                    lerp8(color.c0.b, mid_color.b)},
+               color.c1, 0},
+        Levels{color.c0,
+               RGB8{lerp8(color.c1.r, mid_color.r), lerp8(color.c1.g, mid_color.g),
+                    lerp8(color.c1.b, mid_color.b)},
+               1},
+    };
+
+    // Pick the candidate with the lowest squared error over the visible
+    // texels (indices 0/1/2 use the levels, index 3 is alpha-masked).
+    const Levels* best = &candidates[0];
+    int64_t best_error = INT64_MAX;
+    for (const Levels& candidate : candidates) {
+      int64_t error = 0;
+      for (uint32_t i = 0; i < 16; ++i) {
+        const uint32_t index = color.indices[i];
+        if (index >= 3) {
+          continue;
+        }
+        const RGB8& level = (index == 0)    ? candidate.level0
+                            : (index == 1)  ? candidate.level1
+                                            : (candidate.mid_bit ? candidate.level1
+                                                                 : candidate.level0);
+        const RGB8& target = (index == 0)   ? color.c0
+                             : (index == 1) ? color.c1
+                                            : mid_color;
+        const int64_t dr = int32_t(target.r) - int32_t(level.r);
+        const int64_t dg = int32_t(target.g) - int32_t(level.g);
+        const int64_t db = int32_t(target.b) - int32_t(level.b);
+        error += dr * dr + dg * dg + db * db;
+      }
+      if (error < best_error) {
+        best_error = error;
+        best = &candidate;
+      }
+    }
+
+    ASTCEndpoints endpoints;
+    endpoints.e0[0] = best->level0.r;
+    endpoints.e0[1] = best->level0.g;
+    endpoints.e0[2] = best->level0.b;
+    endpoints.e0[3] = 255;
+    endpoints.e1[0] = best->level1.r;
+    endpoints.e1[1] = best->level1.g;
+    endpoints.e1[2] = best->level1.b;
+    endpoints.e1[3] = 0;
+    bool invert = false;
+    if (int32_t(RGBSum(endpoints.e1)) < int32_t(RGBSum(endpoints.e0))) {
+      std::swap(endpoints.e0, endpoints.e1);
+      invert = true;
+    }
+    ASTCPackHeader(out, kASTCBlockMode1BitDual, 12);
+    ASTCPackEndpointsCEM12(out, endpoints);
+    // Weights: 16 positions, plane 0 (RGB) then plane 1 (alpha) per position,
+    // 1 bit each; stream bits [0, 32). CCS (2 bits) directly below the
+    // weight bits: stream bits 32 and 33 = block bits 95 and 94; value 3
+    // selects alpha as plane 1.
+    for (uint32_t i = 0; i < 16; ++i) {
+      uint32_t rgb_bit, alpha_bit;
+      const uint32_t index = color.indices[i];
+      switch (index) {
+        case 0:
+          rgb_bit = 0;    // e0.rgb
+          alpha_bit = 0;  // e0.a
+          break;
+        case 1:
+          rgb_bit = 1;    // e1.rgb
+          alpha_bit = 0;  // opaque: the endpoint with a=255
+          break;
+        case 2:
+          rgb_bit = best->mid_bit;
+          alpha_bit = 0;
+          break;
+        default:  // 3: transparent
+          // RGB: pick the darker level (transparent texels are black by
+          // spec; alpha-masked in the common alpha-test/blend paths).
+          rgb_bit = (int32_t(RGBSum(best->level0)) <= int32_t(RGBSum(best->level1))) ? 0 : 1;
+          alpha_bit = 1;
+          break;
+      }
+      if (invert) {
+        rgb_bit ^= 1;
+        alpha_bit ^= 1;
+      }
+      ASTCPackWeight(out, 2 * i, rgb_bit, 1);
+      ASTCPackWeight(out, 2 * i + 1, alpha_bit, 1);
+    }
+    // CCS = 3 (alpha on plane 1) at stream bits 32..33.
+    ASTCPackWeight(out, 32, 3, 2);
+  }
+}
+
+void TranscodeDXT23BlockToETC2RGBA(uint64_t rgb_block, uint64_t alpha_block, uint8_t* out) {
+  const DXT1ColorBlock color = DecodeDXT23Color(rgb_block);
+  RGB8 pixels[16];
+  Decode4ColorPixels(color, pixels);
+  uint8_t alpha[16];
+  DecodeBC2Alpha(alpha_block, alpha);
+  StoreBE64(out, EACEncodeAlpha(alpha));
+  StoreBE64(out + 8, ETC2EncodeRGB(pixels));
+}
+
+void TranscodeDXT45BlockToETC2RGBA(uint64_t rgb_block, uint64_t alpha_block, uint8_t* out) {
+  const DXT1ColorBlock color = DecodeDXT23Color(rgb_block);
+  RGB8 pixels[16];
+  Decode4ColorPixels(color, pixels);
+  uint8_t alpha[16];
+  DecodeBC3Alpha(alpha_block, alpha);
+  StoreBE64(out, EACEncodeAlpha(alpha));
+  StoreBE64(out + 8, ETC2EncodeRGB(pixels));
+}
+
+void TranscodeDXT5ABlockToEACR11(uint64_t block, uint8_t* out) {
+  uint8_t values[16];
+  DecodeBC3Alpha(block, values);
+  StoreBE64(out, EACEncodeR11(values));
+}
+
+void TranscodeDXNBlockToEACRG11(uint64_t red_block, uint64_t green_block, uint8_t* out) {
+  // Guest DXN block: 16 bytes = red (first 8) + green (second 8). The EAC
+  // RG11 block layout matches: R block first, then G block.
+  uint8_t red[16], green[16];
+  DecodeBC3Alpha(red_block, red);
+  DecodeBC3Alpha(green_block, green);
+  StoreBE64(out, EACEncodeR11(red));
+  StoreBE64(out + 8, EACEncodeR11(green));
+}
