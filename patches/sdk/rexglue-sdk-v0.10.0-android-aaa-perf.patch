+/**
+ * @file        bc_transcoder.cpp
+ * @brief       CPU-side BCn (S3TC) -> ASTC/ETC2/EAC block transcoding
+ *
+ * @copyright   Copyright (c) 2026
+ *              All rights reserved.
+ *
+ * @license     BSD 3-Clause License (ReXGlue SDK derivative work)
+ *
+ * Bit-level formats implemented exactly per the Khronos Data Format
+ * Specification 1.3 (astc.txt / etc2.txt):
+ *   - ASTC 4x4, CEM 12 (LDR RGBA direct), single-partition:
+ *       block mode 0x42 (2-bit weights) / 0x441 (1-bit weights, dual plane),
+ *       endpoints v0..v7 = (e0.r, e1.r, e0.g, e1.g, e0.b, e1.b, e0.a, e1.a)
+ *       as raw 8-bit values starting at bit 17 (LSB first, ascending);
+ *       weights packed top-down (stream bit n = block bit 127-n, raster
+ *       order, dual plane emits plane 0 then plane 1 per position);
+ *       CCS (dual plane) directly below the weight bits.
+ *   - ETC2 RGBA8: 16-byte block = 64-bit EAC alpha word followed by the
+ *       64-bit ETC2 color word, both big-endian (q0 = bits 63..56).
+ *   - EAC R11/RG11: 64-bit word per channel, same header layout as EAC
+ *       alpha, value = clamp(8*base + 4 + 8*mod*mult, 0, 2047).
+ *
+ * Correctness of every encoder is covered by a host-side test harness that
+ * cross-validates the transcoded blocks with an independent decoder (see
+ * scripts/verify_bc_transcoder.py in the port repository).
+ */
+
+#include <algorithm>
+#include <cstdint>
+#include <cstring>
+
+#include <rex/graphics/vulkan/bc_transcoder.h>
+
+namespace rex::graphics::vulkan::bc_transcode {
+
+namespace {
+
+//=============================================================================
+// Guest BCn decoding (exact per the S3TC/DirectX specs)
+//=============================================================================
+
+struct RGB8 {
+  uint8_t r, g, b;
+};
+
+inline RGB8 Expand565(uint16_t c) {
+  const uint32_t r = (c >> 11) & 31, g = (c >> 5) & 63, b = c & 31;
+  return RGB8{uint8_t((r << 3) | (r >> 2)), uint8_t((g << 2) | (g >> 4)),
+              uint8_t((b << 3) | (b >> 2))};
+}
+
+// Decodes a DXT1 8-byte color block (host order). Returns endpoints and per
+// texel palette indices. Punchthrough (3-color) mode is reported separately.
+struct DXT1ColorBlock {
+  RGB8 c0, c1;
+  bool punchthrough;
+  uint8_t indices[16];  // 2 bits per texel, raster order
+};
+
+DXT1ColorBlock DecodeDXT1Color(uint64_t block) {
+  DXT1ColorBlock out;
+  const uint16_t c0_raw = uint16_t(block & 0xFFFF);
+  const uint16_t c1_raw = uint16_t((block >> 16) & 0xFFFF);
+  out.c0 = Expand565(c0_raw);
+  out.c1 = Expand565(c1_raw);
+  // 4-color mode if c0 > c1 (as 16-bit codewords), else 3-color +
+  // transparent ("punchthrough").
+  out.punchthrough = c0_raw <= c1_raw;
+  const uint32_t indices = uint32_t(block >> 32);
+  for (uint32_t i = 0; i < 16; ++i) {
+    out.indices[i] = uint8_t((indices >> (2 * i)) & 3);
+  }
+  return out;
+}
+
+// BC2/BC3 color blocks always use the 4-color mode (alpha is separate).
+DXT1ColorBlock DecodeDXT23Color(uint64_t block) {
+  DXT1ColorBlock out = DecodeDXT1Color(block);
+  out.punchthrough = false;
+  return out;
+}
+
+// Decodes 16 alpha samples from a BC3/BC4 8-byte alpha block.
+void DecodeBC3Alpha(uint64_t block, uint8_t out[16]) {
+  const uint32_t a0 = uint32_t(block & 0xFF);
+  const uint32_t a1 = uint32_t((block >> 8) & 0xFF);
+  uint32_t levels[8];
+  if (a0 > a1) {
+    levels[0] = a0;
+    levels[1] = a1;
+    levels[2] = (6 * a0 + a1) / 7;
+    levels[3] = (5 * a0 + 2 * a1) / 7;
+    levels[4] = (4 * a0 + 3 * a1) / 7;
+    levels[5] = (3 * a0 + 4 * a1) / 7;
+    levels[6] = (2 * a0 + 5 * a1) / 7;
+    levels[7] = (a0 + 6 * a1) / 7;
+  } else {
+    levels[0] = a0;
+    levels[1] = a1;
+    levels[2] = (4 * a0 + a1) / 5;
+    levels[3] = (3 * a0 + 2 * a1) / 5;
+    levels[4] = (2 * a0 + 3 * a1) / 5;
+    levels[5] = (a0 + 4 * a1) / 5;
+    levels[6] = 0;
+    levels[7] = 255;
+  }
+  const uint64_t indices = block >> 16;
+  for (uint32_t i = 0; i < 16; ++i) {
+    const uint32_t index = uint32_t((indices >> (3 * i)) & 7);
+    out[i] = uint8_t(levels[index]);
+  }
+}
+
+inline uint8_t Nibble4To8(uint32_t n) { return uint8_t((n << 4) | n); }
+
+// BC2 explicit 4-bit alpha.
+void DecodeBC2Alpha(uint64_t block, uint8_t out[16]) {
+  for (uint32_t i = 0; i < 16; ++i) {
+    out[i] = Nibble4To8(uint32_t((block >> (4 * i)) & 0xF));
+  }
+}
+
+// Decodes the 16 RGB samples of a 4-color-mode DXT-style block (raster).
+void Decode4ColorPixels(const DXT1ColorBlock& block, RGB8 out[16]) {
+  // Interpolation (2 bits): 0 -> c0, 1 -> (2c0+c1)/3, 2 -> (c0+2c1)/3,
+  // 3 -> c1, with +1 rounding as in reference decoders.
+  for (uint32_t i = 0; i < 16; ++i) {
+    const uint32_t index = block.indices[i];
+    switch (index) {
+      case 0:
+        out[i] = block.c0;
+        break;
+      case 3:
+        out[i] = block.c1;
+        break;
+      default: {
+        const uint32_t w = (index == 1) ? 1 : 2;  // thirds towards c1
+        out[i] = RGB8{uint8_t((uint32_t(block.c0.r) * (3 - w) + uint32_t(block.c1.r) * w + 1) / 3),
+                      uint8_t((uint32_t(block.c0.g) * (3 - w) + uint32_t(block.c1.g) * w + 1) / 3),
+                      uint8_t((uint32_t(block.c0.b) * (3 - w) + uint32_t(block.c1.b) * w + 1) / 3)};
+        break;
+      }
+    }
+  }
+}
+
+//=============================================================================
+// ASTC 4x4 packing (CEM 12, single partition)
+//=============================================================================
+
+struct ASTCEndpoints {
+  uint8_t e0[4];  // RGBA
+  uint8_t e1[4];
+};
+
+inline void ASTCPackHeader(uint8_t* out, uint16_t block_mode, uint16_t cem) {
+  // bits [0:11) = block mode, [11:13) = partitions-1 (0), [13:17) = CEM.
+  const uint32_t header = uint32_t(block_mode) | (uint32_t(cem) << 13);
+  out[0] = uint8_t(header & 0xFF);
+  out[1] = uint8_t((header >> 8) & 0xFF);
+  out[2] = uint8_t((header >> 16) & 0xFF);
+  // out[3] starts endpoint data (bits 24+ belong to the endpoint stream).
+}
+
+inline void ASTCSetBits(uint8_t* out, uint32_t bit_pos, uint32_t value, uint32_t count) {
+  for (uint32_t i = 0; i < count; ++i) {
+    const uint32_t bit = bit_pos + i;
+    if ((value >> i) & 1) {
+      out[bit >> 3] |= uint8_t(1u << (bit & 7));
+    } else {
+      out[bit >> 3] &= uint8_t(~(1u << (bit & 7)));
+    }
+  }
+}
+
+inline void ASTCPackWeight(uint8_t* out, uint32_t stream_bit, uint32_t value, uint32_t bits) {
+  // Stream bit n lives at block bit 127-n, value LSB at the lowest stream
+  // bit position of the field.
+  for (uint32_t i = 0; i < bits; ++i) {
+    const uint32_t block_bit = 127 - (stream_bit + i);
+    if ((value >> i) & 1) {
+      out[block_bit >> 3] |= uint8_t(1u << (block_bit & 7));
+    } else {
+      out[block_bit >> 3] &= uint8_t(~(1u << (block_bit & 7)));
+    }
+  }
+}
+
+constexpr uint16_t kASTCBlockMode2Bit = 0x42;  // 4x4, 2-bit weights, 1 plane
+constexpr uint16_t kASTCBlockMode1BitDual = 0x441;  // 4x4, 1-bit weights, 2 planes
+
+void ASTCPackEndpointsCEM12(uint8_t* out, const ASTCEndpoints& endpoints) {
+  // v0..v7 = e0.r, e1.r, e0.g, e1.g, e0.b, e1.b, e0.a, e1.a, 8 bits each,
+  // starting at bit 17.
+  uint32_t bit_pos = 17;
+  const uint8_t values[8] = {
+      endpoints.e0[0], endpoints.e1[0], endpoints.e0[1], endpoints.e1[1],
+      endpoints.e0[2], endpoints.e1[2], endpoints.e0[3], endpoints.e1[3],
+  };
+  for (uint32_t i = 0; i < 8; ++i) {
+    ASTCSetBits(out, bit_pos, values[i], 8);
+    bit_pos += 8;
+  }
+}
+
+inline uint32_t RGBSum(const uint8_t* c) { return c[0] + c[1] + c[2]; }
+
+inline uint32_t RGBSum(const RGB8& c) { return c.r + c.g + c.b; }
+
+//=============================================================================
+// ETC2 / EAC packing
+//=============================================================================
+
+// EAC modifier tables (16 x 8), index order 0..7 (Khronos Data Format spec).
+constexpr int16_t kEACModifierTables[16][8] = {
+    {-3, -6, -9, -15, 2, 5, 8, 14},    {-3, -7, -10, -13, 2, 6, 9, 12},
+    {-2, -5, -8, -13, 1, 4, 7, 12},    {-2, -4, -6, -13, 1, 3, 5, 12},
+    {-3, -6, -8, -12, 2, 5, 7, 11},    {-3, -7, -9, -11, 2, 6, 8, 10},
+    {-4, -7, -8, -11, 3, 6, 7, 10},    {-3, -5, -8, -11, 2, 4, 7, 10},
+    {-2, -6, -8, -10, 1, 5, 7, 9},     {-2, -5, -8, -10, 1, 4, 7, 9},
+    {-2, -4, -8, -10, 1, 3, 7, 9},     {-2, -5, -7, -10, 1, 4, 6, 9},
+    {-3, -4, -7, -10, 2, 3, 6, 9},     {-1, -2, -3, -10, 0, 1, 2, 9},
+    {-4, -6, -8, -9, 3, 5, 7, 8},      {-3, -5, -7, -9, 2, 4, 6, 8},
+};
+
+// ETC2 RGB modifier tables (8 x 4), entry order {-b, -a, +a, +b}.
+constexpr int16_t kETC2ModifierTables[8][4] = {
+    {-8, -2, 2, 8},     {-17, -5, 5, 17},  {-29, -9, 9, 29},  {-42, -13, 13, 42},
+    {-60, -18, 18, 60}, {-80, -24, 24, 80}, {-106, -33, 33, 106},
+    {-183, -47, 47, 183},
+};
+
+// Maps a 2-bit pixel index (MSB:LSB) to the modifier table entry.
+// 0 -> +a (2), 1 -> +b (3), 2 -> -a (1), 3 -> -b (0).
+constexpr uint32_t kETC2IndexToTable[4] = {2, 3, 1, 0};
+
+inline uint64_t EACPackBlock(uint32_t base, uint32_t multiplier, uint32_t table_index,
+                              const uint8_t* indices) {
+  // Bits 63..56 base, 55..52 multiplier, 51..48 table index, 47..0 =
+  // 16 3-bit indices. The EAC index order is the ETC2 "letter" order
+  // (a, b, c, d = the FIRST COLUMN, then column 2, ...), i.e. for a raster
+  // pixel (x, y) the letter index is x * 4 + y - the transpose of raster
+  // order. `indices` is raster-ordered (x + 4 * y) and remapped here.
+  uint64_t block = 0;
+  block |= uint64_t(base & 0xFF) << 56;
+  block |= uint64_t(multiplier & 0xF) << 52;
+  block |= uint64_t(table_index & 0xF) << 48;
+  for (uint32_t i = 0; i < 16; ++i) {
+    const uint32_t letter = (i & 3) * 4 + (i >> 2);
+    block |= uint64_t(indices[i] & 7) << (45 - 3 * letter);
+  }
+  return block;
+}
+
+inline void StoreBE64(uint8_t* out, uint64_t v) {
+  out[0] = uint8_t(v >> 56);
+  out[1] = uint8_t(v >> 48);
+  out[2] = uint8_t(v >> 40);
+  out[3] = uint8_t(v >> 32);
+  out[4] = uint8_t(v >> 24);
+  out[5] = uint8_t(v >> 16);
+  out[6] = uint8_t(v >> 8);
+  out[7] = uint8_t(v);
+}
+
+// Fits an EAC alpha block to 16 target values in [0, 255]. Small search over
+// (base, multiplier, table); exact for {0, 255}-only punchthrough content.
+uint64_t EACEncodeAlpha(const uint8_t* values) {
+  // Fast path: only 0/255 present (BC1 punchthrough routed through ETC2).
+  bool binary_alpha = true;
+  for (uint32_t i = 0; i < 16; ++i) {
+    if (values[i] != 0 && values[i] != 255) {
+      binary_alpha = false;
+      break;
+    }
+  }
+  if (binary_alpha) {
+    // Table 13: mods {-1,-2,-3,-10,0,1,2,9}, multiplier 15, base 127:
+    //   -10*15 + 127 = -23  -> clamps to 0
+    //    +9*15 + 127 = 262  -> clamps to 255
+    uint8_t indices[16];
+    for (uint32_t i = 0; i < 16; ++i) {
+      indices[i] = values[i] ? 7 : 3;
+    }
+    return EACPackBlock(127, 15, 13, indices);
+  }
+
+  // General fit: pick base from the value range, then search a small set of
+  // (table, multiplier) combinations, selecting the nearest modifier index
+  // per pixel.
+  uint32_t vmin = 255, vmax = 0;
+  for (uint32_t i = 0; i < 16; ++i) {
+    vmin = std::min<uint32_t>(vmin, values[i]);
+    vmax = std::max<uint32_t>(vmax, values[i]);
+  }
+  const uint32_t base = (vmin + vmax + 1) / 2;
+  static constexpr uint32_t kTables[] = {13, 15, 11, 3, 12, 4, 8, 0};
+  uint64_t best_block = 0;
+  int64_t best_error = INT64_MAX;
+  for (uint32_t table : kTables) {
+    for (uint32_t multiplier = 1; multiplier <= 15; ++multiplier) {
+      uint8_t indices[16];
+      int64_t error = 0;
+      for (uint32_t i = 0; i < 16; ++i) {
+        const int64_t target = values[i];
+        int64_t best_pixel_error = INT64_MAX;
+        uint32_t best_index = 0;
+        for (uint32_t m = 0; m < 8; ++m) {
+          const int64_t level = std::clamp<int64_t>(
+              int64_t(base) + int64_t(kEACModifierTables[table][m]) * int64_t(multiplier), 0,
+              255);
+          const int64_t pixel_error = std::llabs(target - level);
+          if (pixel_error < best_pixel_error) {
+            best_pixel_error = pixel_error;
+            best_index = m;
+          }
+        }
+        indices[i] = uint8_t(best_index);
+        error += best_pixel_error * best_pixel_error;
+      }
+      if (error < best_error) {
+        best_error = error;
+        best_block = EACPackBlock(base, multiplier, table, indices);
+      }
+    }
+  }
+  return best_block;
+}
+
+// ETC2 RGB differential/individual mode mini-encoder for 16 RGB samples.
+// Tries both flips and both modes, keeps the lowest squared error.
+uint64_t ETC2EncodeRGB(const RGB8* pixels) {
+  struct Candidate {
+    uint64_t block;
+    int64_t error;
+  };
+  Candidate best{0, INT64_MAX};
+
+  const auto evaluate = [&](bool flip, bool differential) {
+    // Subblock membership: flip=0 -> left/right 2x4 columns, flip=1 ->
+    // top/bottom 4x2 rows.
+    uint8_t subblock_of[16];
+    for (uint32_t y = 0; y < 4; ++y) {
+      for (uint32_t x = 0; x < 4; ++x) {
+        subblock_of[y * 4 + x] = uint8_t(flip ? (y < 2 ? 0 : 1) : (x < 2 ? 0 : 1));
+      }
+    }
+    // Subblock means.
+    uint32_t sum[2][3] = {{0, 0, 0}, {0, 0, 0}};
+    uint32_t count[2] = {0, 0};
+    for (uint32_t i = 0; i < 16; ++i) {
+      const uint32_t s = subblock_of[i];
+      sum[s][0] += pixels[i].r;
+      sum[s][1] += pixels[i].g;
+      sum[s][2] += pixels[i].b;
+      ++count[s];
+    }
+    uint32_t base[2][3];  // 5-bit (differential) or 4-bit (individual) codes
+    for (uint32_t s = 0; s < 2; ++s) {
+      for (uint32_t c = 0; c < 3; ++c) {
+        const uint32_t mean = (sum[s][c] + count[s] / 2) / count[s];
+        if (differential) {
+          base[s][c] = mean >> 3;  // 5-bit
+        } else {
+          base[s][c] = mean >> 4;  // 4-bit
+        }
+      }
+    }
+    uint32_t codes[2][3];
+    if (differential) {
+      for (uint32_t c = 0; c < 3; ++c) {
+        // base1 + d must stay in [0, 31] with d in [-4, 3] - clamp the
+        // second subblock's 5-bit code into reach of the first.
+        int32_t second = int32_t(base[1][c]);
+        const int32_t delta = second - int32_t(base[0][c]);
+        if (delta > 3) {
+          second = int32_t(base[0][c]) + 3;
+        } else if (delta < -4) {
+          second = int32_t(base[0][c]) - 4;
+        }
+        base[1][c] = uint32_t(std::clamp<int32_t>(second, 0, 31));
+      }
+      for (uint32_t s = 0; s < 2; ++s) {
+        for (uint32_t c = 0; c < 3; ++c) {
+          codes[s][c] = base[s][c];
+        }
+      }
+    } else {
+      for (uint32_t s = 0; s < 2; ++s) {
+        for (uint32_t c = 0; c < 3; ++c) {
+          codes[s][c] = std::min<uint32_t>(base[s][c], 15);
+        }
+      }
+    }
+    // Extend to 8-bit base colors.
+    uint8_t base_color[2][3];
+    for (uint32_t s = 0; s < 2; ++s) {
+      for (uint32_t c = 0; c < 3; ++c) {
+        if (differential) {
+          const uint32_t v5 = codes[s][c];
+          base_color[s][c] = uint8_t((v5 << 3) | (v5 >> 2));
+        } else {
+          const uint32_t v4 = codes[s][c];
+          base_color[s][c] = uint8_t((v4 << 4) | v4);
+        }
+      }
+    }
+    // Choose modifier tables per subblock: evaluate all 8 tables (per-pixel
+    // best index, squared error) and keep the lowest - the modifier is a
+    // scalar added to every channel, so its magnitude must cover the
+    // subblock's deviation from the base color.
+    uint32_t table[2] = {0, 0};
+    for (uint32_t s = 0; s < 2; ++s) {
+      int64_t best_table_error = INT64_MAX;
+      uint32_t chosen = 0;
+      for (uint32_t t = 0; t < 8; ++t) {
+        int64_t table_error = 0;
+        for (uint32_t i = 0; i < 16; ++i) {
+          if (subblock_of[i] != s) {
+            continue;
+          }
+          int64_t best_pixel_error = INT64_MAX;
+          for (uint32_t v = 0; v < 4; ++v) {
+            const int32_t mod = kETC2ModifierTables[t][kETC2IndexToTable[v]];
+            int64_t pixel_error = 0;
+            pixel_error += std::llabs(int64_t(pixels[i].r) -
+                                      std::clamp<int64_t>(base_color[s][0] + mod, 0, 255));
+            pixel_error += std::llabs(int64_t(pixels[i].g) -
+                                      std::clamp<int64_t>(base_color[s][1] + mod, 0, 255));
+            pixel_error += std::llabs(int64_t(pixels[i].b) -
+                                      std::clamp<int64_t>(base_color[s][2] + mod, 0, 255));
+            best_pixel_error = std::min(best_pixel_error, pixel_error);
+          }
+          table_error += best_pixel_error;
+        }
+        if (table_error < best_table_error) {
+          best_table_error = table_error;
+          chosen = t;
+        }
+      }
+      table[s] = chosen;
+    }
+    uint8_t indices[16];
+    int64_t error = 0;
+    for (uint32_t i = 0; i < 16; ++i) {
+      const uint32_t s = subblock_of[i];
+      int64_t best_pixel_error = INT64_MAX;
+      uint32_t best_index = 0;
+      for (uint32_t v = 0; v < 4; ++v) {
+        const int32_t mod = kETC2ModifierTables[table[s]][kETC2IndexToTable[v]];
+        int64_t pixel_error = 0;
+        pixel_error += std::llabs(int64_t(pixels[i].r) -
+                                  std::clamp<int64_t>(base_color[s][0] + mod, 0, 255));
+        pixel_error += std::llabs(int64_t(pixels[i].g) -
+                                  std::clamp<int64_t>(base_color[s][1] + mod, 0, 255));
+        pixel_error += std::llabs(int64_t(pixels[i].b) -
+                                  std::clamp<int64_t>(base_color[s][2] + mod, 0, 255));
+        if (pixel_error < best_pixel_error) {
+          best_pixel_error = pixel_error;
+          best_index = v;
+        }
+      }
+      indices[i] = uint8_t(best_index);
+      error += best_pixel_error * best_pixel_error;
+    }
+    // Pack the block.
+    uint64_t block = 0;
+    if (differential) {
+      block |= uint64_t(codes[0][0] & 31) << 59;
+      block |= uint64_t((int32_t(codes[1][0]) - int32_t(codes[0][0])) & 7) << 56;
+      block |= uint64_t(codes[0][1] & 31) << 51;
+      block |= uint64_t((int32_t(codes[1][1]) - int32_t(codes[0][1])) & 7) << 48;
+      block |= uint64_t(codes[0][2] & 31) << 43;
+      block |= uint64_t((int32_t(codes[1][2]) - int32_t(codes[0][2])) & 7) << 40;
+      block |= uint64_t(1) << 33;  // Differential bit.
+    } else {
+      block |= uint64_t(codes[0][0] & 15) << 60;
+      block |= uint64_t(codes[1][0] & 15) << 56;
+      block |= uint64_t(codes[0][1] & 15) << 52;
+      block |= uint64_t(codes[1][1] & 15) << 48;
+      block |= uint64_t(codes[0][2] & 15) << 44;
+      block |= uint64_t(codes[1][2] & 15) << 40;
+    }
+    block |= uint64_t(table[0] & 7) << 37;
+    block |= uint64_t(table[1] & 7) << 34;
+    block |= uint64_t(flip ? 1 : 0) << 32;
+    for (uint32_t i = 0; i < 16; ++i) {
+      // Pixel index bits are in the ETC2 letter order (a, b, c, d = the
+      // first column): for raster pixel i = (x, y) the letter is
+      // x * 4 + y. MSB at bit 16 + letter, LSB at bit letter.
+      const uint32_t letter = (i & 3) * 4 + (i >> 2);
+      const uint32_t msb = (indices[i] >> 1) & 1;
+      const uint32_t lsb = indices[i] & 1;
+      block |= uint64_t(msb) << (16 + letter);
+      block |= uint64_t(lsb) << letter;
+    }
+    if (error < best.error) {
+      best.block = block;
+      best.error = error;
+    }
+  };
+
+  evaluate(false, true);
+  evaluate(true, true);
+  evaluate(false, false);
+  evaluate(true, false);
+  return best.block;
+}
+
+// Fits an EAC R11 block to 16 8-bit values. Decoded 11-bit level:
+// clamp(8*base + 4 + 8*mod*mult, 0, 2047) ~ round(v * 2047 / 255).
+uint64_t EACEncodeR11(const uint8_t* values) {
+  uint32_t vmin = 255, vmax = 0;
+  for (uint32_t i = 0; i < 16; ++i) {
+    vmin = std::min<uint32_t>(vmin, values[i]);
+    vmax = std::max<uint32_t>(vmax, values[i]);
+  }
+  // Target 11-bit values.
+  int64_t targets[16];
+  for (uint32_t i = 0; i < 16; ++i) {
+    targets[i] = (int64_t(values[i]) * 2047 + 127) / 255;
+  }
+  const int64_t tmin = (int64_t(vmin) * 2047 + 127) / 255;
+  const int64_t tmax = (int64_t(vmax) * 2047 + 127) / 255;
+  // level(base, 0 mod) = 8*base + 4 -> base near the midpoint.
+  uint32_t base = uint32_t(std::clamp<int64_t>((tmin + tmax - 8) / 16, 0, 255));
+  static constexpr uint32_t kTables[] = {13, 15, 11, 3, 12, 4, 8, 0};
+  uint64_t best_block = 0;
+  int64_t best_error = INT64_MAX;
+  for (uint32_t table : kTables) {
+    for (uint32_t multiplier = 1; multiplier <= 15; ++multiplier) {
+      uint8_t indices[16];
+      int64_t error = 0;
+      for (uint32_t i = 0; i < 16; ++i) {
+        int64_t best_pixel_error = INT64_MAX;
+        uint32_t best_index = 0;
+        for (uint32_t m = 0; m < 8; ++m) {
+          const int64_t level = std::clamp<int64_t>(
+              int64_t(base) * 8 + 4 + 8 * int64_t(kEACModifierTables[table][m]) * multiplier, 0,
+              2047);
+          const int64_t pixel_error = std::llabs(targets[i] - level);
+          if (pixel_error < best_pixel_error) {
+            best_pixel_error = pixel_error;
+            best_index = m;
+          }
+        }
+        indices[i] = uint8_t(best_index);
+        error += best_pixel_error * best_pixel_error;
+      }
+      if (error < best_error) {
+        best_error = error;
+        best_block = EACPackBlock(base, multiplier, table, indices);
+      }
+    }
+  }
+  return best_block;
+}
