--- a/src/core/filesystem_posix.cpp	2026-09-03 19:05:18.000000000 +0000
+++ b/src/core/filesystem_posix.cpp	2026-09-03 19:11:39.683715504 +0000
@@ -30,6 +30,10 @@
 #include <rex/platform/env.h>
 #include <rex/string.h>
 
+#if REX_PLATFORM_ANDROID
+#include <rex/main_android.h>
+#endif
