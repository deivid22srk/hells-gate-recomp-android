--- a/include/rex/graphics/vulkan/render_target_cache.h
+++ b/include/rex/graphics/vulkan/render_target_cache.h
@@ -164,6 +164,51 @@
       xenos::MsaaSamples msaa_samples = xenos::MsaaSamples::k1X,
       bool* is_integer_out = nullptr) const;
 
+  // Native frame renderer (rexgpu-native plugin) EDRAM bridge.
+  //
+  // The native frame renderer draws the main surface passes into its own
+  // Vulkan images, bypassing the render targets of this cache, while the
+  // game's post-processing (and everything sampled by it) still runs through
+  // the emulated EDRAM resolves. For a resolve of the natively rendered
+  // surface to produce the expected texture contents, the native image has to
+  // be copied into the EDRAM storage buffer in the guest layout - the exact
+  // operation the dump compute shaders (used by Resolve for host render
+  // targets) perform for this cache's own render targets.
+  //
+  // Allocates and writes a transfer-source descriptor set (from the same
+  // pools the render targets use) for the given views. Returns SIZE_MAX in
+  // case of a failure. The views must be created with the formats returned by
+  // GetColorOwnershipTransferVulkanFormat (for color; the stencil view is a
+  // VK_FORMAT_S8_UINT view of the stencil aspect) and must remain valid as
+  // long as the descriptor set is used.
+  size_t AllocateExternalDumpDescriptorSet(VkImageView view, VkImageView stencil_view);
+  void FreeExternalDumpDescriptorSet(bool is_depth, size_t descriptor_set_index) {
+    assert_true(descriptor_set_index != SIZE_MAX);
+    (is_depth ? *descriptor_set_pool_sampled_image_x2_ : *descriptor_set_pool_sampled_image_)
+        .Free(descriptor_set_index);
+  }
+
+  // Dumps the full EDRAM tile box of an externally owned image (the EDRAM
+  // location and format given as the RenderTargetKey fields - base_tiles,
+  // pitch_tiles_at_32bpp, msaa_samples, is_depth, resource_format) into the
+  // EDRAM storage buffer, so a subsequent Resolve reads the externally
+  // rendered pixels for the covered tiles. The image is transitioned from
+  // (current_stage_mask, current_access_mask, current_layout) to
+  // SHADER_READ_ONLY_OPTIMAL and back to (restored_stage_mask,
+  // restored_access_mask, restored_layout) by this call. Returns false
+  // (without touching the EDRAM buffer) if the dump pipeline is unavailable
+  // for the format.
+  bool DumpExternalImageToEdram(uint32_t source_base_tiles,
+                                uint32_t source_pitch_tiles_at_32bpp,
+                                xenos::MsaaSamples source_msaa_samples, bool source_is_depth,
+                                uint32_t source_resource_format, size_t descriptor_set_index,
+                                VkImage source_image, VkPipelineStageFlags current_stage_mask,
+                                VkAccessFlags current_access_mask, VkImageLayout current_layout,
+                                VkPipelineStageFlags restored_stage_mask,
+                                VkAccessFlags restored_access_mask,
+                                VkImageLayout restored_layout, uint32_t height_tiles,
+                                uint32_t dest_first_tile, uint32_t dest_pitch_tiles);
+
  protected:
   uint32_t GetMaxRenderTargetWidth() const override;
   uint32_t GetMaxRenderTargetHeight() const override;
