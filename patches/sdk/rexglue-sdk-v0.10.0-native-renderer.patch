+#ifdef REXGPU_NATIVE_FRAME_RENDERER
+  // ARM-native frame renderer (rexgpu-native plugin). Non-fatal on failure -
+  // the emulated path remains fully functional as the fallback.
+  native_frame_renderer_ = std::make_unique<NativeFrameRenderer>(*this);
+  if (!native_frame_renderer_->Initialize()) {
+    REXGPU_WARN("Failed to initialize the ARM-native frame renderer; "
+                "continuing with pure emulated rendering");
