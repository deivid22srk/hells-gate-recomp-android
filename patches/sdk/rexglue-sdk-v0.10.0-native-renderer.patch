diff --git a/include/rex/graphics/vulkan/native_frame_renderer.h b/include/rex/graphics/vulkan/native_frame_renderer.h
new file mode 100644
--- /dev/null
+++ b/include/rex/graphics/vulkan/native_frame_renderer.h
@@ -0,0 +1,284 @@
+/**
+ * @file        vulkan/native_frame_renderer.h
+ * @brief       ARM-native frame renderer for the Vulkan command processor
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ *
+ * @remarks     Skate 3 Mobile-style native rendering for the recomp port,
+ *              with an EDRAM bridge for titles that post-process the frame:
+ *              the game's draws still arrive through the Xenos command
+ *              processor (PM4 parsing, fences, queries, memexport and guest
+ *              shader translation stay intact). Draws targeting the
+ *              swap-sized surfaces (the MSAA scene pass and the final
+ *              composite) are rendered directly into dedicated Vulkan color +
+ *              depth targets, bypassing the EDRAM render target emulation for
+ *              the heavy scene work; every other surface (render-to-texture,
+ *              post chains, shadow maps) keeps rendering on the fully
+ *              emulated path so its data stays available to the game.
+ *
+ *              Dante's Inferno (and similar titles) compose the final image
+ *              in a swap-sized pass that samples textures produced by EDRAM
+ *              resolves of the scene surface. Since the scene no longer
+ *              writes the emulated EDRAM, PrepareResolve (called before the
+ *              emulated resolve) dumps the native frame content of the
+ *              resolved surface into the EDRAM storage buffer - through the
+ *              render target cache's own dump compute shaders, in the exact
+ *              guest layout the resolve copy reads - so the resolve produces
+ *              the real scene pixels. The final composite then renders into
+ *              the native frame again, and PresentFrame blits the composited
+ *              result into the presenter's guest output at swap.
+ *
+ *              Per frame:
+ *               - the first main-pass draw of each target set clears that
+ *                 set's targets, later draws load them;
+ *               - draws outside the swap-sized surfaces (render-to-texture,
+ *                 half-resolution post chains, shadow maps - identified by
+ *                 real surface width, NOT raw EDRAM pitch: at 4x MSAA the
+ *                 1280-wide main surface has pitch 640, the same value as a
+ *                 1x 640-wide half-resolution post surface) run on the fully
+ *                 emulated path;
+ *               - memexport draws still run on the emulated path for their
+ *                 memory side effects;
+ *               - guest resolves of the native surfaces dump the native
+ *                 content into the EDRAM buffer before the emulated resolve;
+ *               - at swap the latest written native color target is blitted
+ *                 into the presenter's guest output image (the emulated
+ *                 frontbuffer resolve + gamma/FXAA chain is skipped; the
+ *                 presenter paints the image directly).
+ *
+ *              If the EDRAM bridge cannot run on the current device (dump
+ *              pipeline or descriptor allocation failure), the renderer
+ *              disables itself for the session and everything falls back to
+ *              the fully emulated behavior - a black screen is never shown
+ *              because of the native renderer.
+ */
+
+#pragma once
+
+#include <cstdint>
+#include <filesystem>
+#include <unordered_map>
+#include <vector>
+
+#include <rex/graphics/pipeline/render_target/cache.h>
+#include <rex/graphics/primitive_processor.h>
+#include <rex/graphics/registers.h>
+#include <rex/graphics/vulkan/pipeline_cache.h>
+#include <rex/memory.h>
+#include <rex/ui/vulkan/api.h>
+#include <rex/graphics/xenos.h>
+
+namespace rex::graphics {
+
+namespace vulkan {
+
+class VulkanCommandProcessor;
+class VulkanRenderTargetCache;
+
+class NativeFrameRenderer {
+ public:
+  // What IssueDraw should do with the current draw.
+  enum class DrawRoute {
+    // Run the full emulated path (render target cache + pipeline cache).
+    kEmulated,
+    // Suppress entirely (non-rasterization work nothing displays consumes).
+    kSkip,
+    // Render through the native frame targets.
+    kNative,
+  };
+
+  explicit NativeFrameRenderer(VulkanCommandProcessor& command_processor);
+  ~NativeFrameRenderer();
+
+  bool Initialize();
+  void Shutdown();
+
+  // Persistent driver pipeline cache (called by the command processor when
+  // the title's shader storage is initialized).
+  bool InitializePipelineCache(const std::filesystem::path& cache_root, uint32_t title_id);
+  void ShutdownPipelineCache();
+  void SavePipelineCache();
+
+  // Route the draw currently described by the command processor's register
+  // file. Called from IssueDraw after the shader/memexport analysis.
+  DrawRoute RouteDraw(bool memexport_writes_possible, bool is_rasterization_done);
+
+  // Native pipeline for the current state. Returns false when the draw
+  // cannot be served natively and must fall back (caller routes it to
+  // emulated or drops it).
+  bool GetCurrentPipeline(
+      VulkanShader::VulkanTranslation* vertex_shader,
+      VulkanShader::VulkanTranslation* pixel_shader,
+      const PrimitiveProcessor::ProcessingResult& primitive_processing_result,
+      reg::RB_DEPTHCONTROL normalized_depth_control, uint32_t normalized_color_mask,
+      VkPipeline& pipeline_out,
+      const VulkanPipelineCache::PipelineLayoutProvider*& pipeline_layout_out);
+
+  // Lazily creates the frame targets for the current video mode and enters
+  // the native render pass (ending any render target cache or other native
+  // pass opened earlier). Clears on the first native draw of the frame for
+  // the target set.
+  bool BeginFrameDraw();
+
+  // EDRAM bridge, called from VulkanCommandProcessor::IssueCopy before the
+  // emulated resolve: dumps the native frame content of the resolved native
+  // surface (matching the resolve currently described by the register file)
+  // into the EDRAM storage buffer, in the guest layout the resolve copy
+  // shaders read, so the emulated resolve produces the real scene pixels.
+  void PrepareResolve(const memory::Memory& memory);
+
+  // Permanently falls back to the fully emulated behavior for the rest of the
+  // session (after a bridge failure), so the game keeps rendering instead of
+  // presenting an incomplete frame.
+  void DisableForSession();
+
+  // Called at the guest frame boundary (swap packet). Presents the latest
+  // written native frame content into the presenter's guest output image.
+  // Returns false when the frame had no native content (the caller then falls
+  // back to the emulated presentation path).
+  bool PresentFrame(VkImage guest_output_image, uint32_t guest_output_width,
+                    uint32_t guest_output_height);
+
+  uint32_t frame_draw_count() const { return frame_draw_count_; }
+
+  // Marks that one native draw has been recorded into the current frame.
+  void RecordNativeDraw() { ++frame_draw_count_; }
+
+  void RequestShutdown() { shutdown_requested_ = true; }
+
+ private:
+  // Target set for 1x surfaces, and for multisampled ones (2x guest MSAA is
+  // host-allocated as 4x when 2x attachments are unsupported - both use the
+  // multisample set).
+  static constexpr uint32_t kTargetSetSingleSample = 0;
+  static constexpr uint32_t kTargetSetMultisample = 1;
+  static constexpr uint32_t kTargetSetCount = 2;
+
+  // Transfer-source views and descriptor set used by the EDRAM dump for one
+  // attachment of a target set.
+  struct DumpSource {
+    VkImageView view = VK_NULL_HANDLE;
+    // Stencil aspect view (depth dump sources only).
+    VkImageView stencil_view = VK_NULL_HANDLE;
+    size_t descriptor_set_index = SIZE_MAX;
+  };
+
+  struct FrameTargets {
+    VkImage color = VK_NULL_HANDLE;
+    VkDeviceMemory color_memory = VK_NULL_HANDLE;
+    VkImageView color_view = VK_NULL_HANDLE;
+    VkImage depth = VK_NULL_HANDLE;
+    VkDeviceMemory depth_memory = VK_NULL_HANDLE;
+    VkImageView depth_view = VK_NULL_HANDLE;
+    // Single-sample resolve destination for the color attachment (created
+    // only when samples != 1; blitting from a multisample source image is not
+    // allowed in Vulkan).
+    VkImage resolve = VK_NULL_HANDLE;
+    VkDeviceMemory resolve_memory = VK_NULL_HANDLE;
+    // Views + descriptor sets for the EDRAM dump bridge.
+    DumpSource color_dump_source;
+    DumpSource depth_dump_source;
+    VkFormat color_format = VK_FORMAT_R8G8B8A8_UNORM;
+    VkFormat depth_format = VK_FORMAT_D32_SFLOAT_S8_UINT;
+    VkSampleCountFlagBits samples = VK_SAMPLE_COUNT_1_BIT;
+    uint32_t width = 0;
+    uint32_t height = 0;
+    // Whether the first draw of the current guest frame has cleared the
+    // targets of this set.
+    bool frame_cleared = false;
+    // Whether this set received native draws in the current guest frame (so
+    // its content is what PresentFrame should show).
+    bool written_this_frame = false;
+  };
+
+  // The guest surface (EDRAM location and format) captured from the latest
+  // native draw of a target set, used by PrepareResolve to recognize resolves
+  // of the natively rendered surfaces. The fields mirror RenderTargetKey
+  // (which is protected inside the render target caches) so a matching key can
+  // be built inside the cache's dump entry point.
+  struct NativeSurfaceInfo {
+    bool valid = false;
+    uint32_t base_tiles = 0;
+    uint32_t pitch_tiles_at_32bpp = 0;
+    xenos::MsaaSamples msaa_samples = xenos::MsaaSamples::k1X;
+    bool is_depth = false;
+    uint32_t resource_format = 0;
+    uint32_t height_tiles = 0;
+
+    uint32_t GetPitchTiles() const;
+  };
+
+  uint32_t SetIndexForSamples(VkSampleCountFlagBits samples) const {
+    return samples == VK_SAMPLE_COUNT_1_BIT ? kTargetSetSingleSample : kTargetSetMultisample;
+  }
+  bool EnsureFrameTargets(uint32_t set_index, uint32_t width, uint32_t height,
+                          VkSampleCountFlagBits samples);
+  void DestroyFrameTargets(uint32_t set_index);
+  void DestroyAllFrameTargets();
+  bool EnsureRenderPass(uint32_t set_index, VkFormat color_format, VkFormat depth_format,
+                        VkSampleCountFlagBits samples);
+  bool EnsureFramebuffer(uint32_t set_index, uint32_t width, uint32_t height);
+  // Whether the native render pass of the target set is currently open.
+  bool IsNativePassOpen(uint32_t set_index) const;
+  // Whether any render pass (native or render target cache) is open.
+  bool IsAnyPassOpen() const;
+  // Whether a guest resolve span (base/pitch/rows from GetCopyEdramTileSpan)
+  // overlaps the EDRAM tile box of a captured native surface (EDRAM addressing
+  // wraps at kEdramTileCount).
+  bool SurfaceCoversResolveSpan(const NativeSurfaceInfo& surface, uint32_t span_base,
+                                uint32_t span_pitch, uint32_t span_rows) const;
+  // Dumps one captured native surface's full tile box from its target set's
+  // attachment into the EDRAM buffer (the render target cache's dump compute).
+  void DumpSurfaceToEdram(uint32_t set_index, const NativeSurfaceInfo& surface, bool is_depth);
+
+  VulkanCommandProcessor& command_processor_;
+
+  bool initialized_ = false;
+  bool shutdown_requested_ = false;
+  // Set after an unrecoverable bridge failure - everything emulated for the
+  // rest of the session (never present an incomplete frame).
+  bool disabled_for_session_ = false;
+
+  FrameTargets sets_[kTargetSetCount];
+  // The target set that received the latest native draw of the frame (what
+  // PresentFrame shows).
+  int last_written_set_ = -1;
+  VkRenderPass render_pass_[kTargetSetCount] = {VK_NULL_HANDLE, VK_NULL_HANDLE};
+  VkFormat render_pass_color_format_[kTargetSetCount] = {VK_FORMAT_UNDEFINED,
+                                                         VK_FORMAT_UNDEFINED};
+  VkFormat render_pass_depth_format_[kTargetSetCount] = {VK_FORMAT_UNDEFINED,
+                                                         VK_FORMAT_UNDEFINED};
+  VkSampleCountFlagBits render_pass_samples_[kTargetSetCount] = {VK_SAMPLE_COUNT_1_BIT,
+                                                                 VK_SAMPLE_COUNT_1_BIT};
+  VkFramebuffer framebuffer_[kTargetSetCount] = {VK_NULL_HANDLE, VK_NULL_HANDLE};
+  uint32_t framebuffer_width_[kTargetSetCount] = {};
+  uint32_t framebuffer_height_[kTargetSetCount] = {};
+
+  uint32_t frame_draw_count_ = 0;
+
+  // Per-frame routing statistics (reset at each present attempt).
+  uint32_t frame_skip_count_ = 0;
+  uint32_t frame_emulated_count_ = 0;
+  uint32_t frames_presented_ = 0;
+  uint32_t presents_logged_ = 0;
+  // One-shot routing diagnostics (kept across frames).
+  bool logged_first_native_route_ = false;
+  bool logged_first_skip_route_ = false;
+  bool logged_first_emulated_route_ = false;
+  bool logged_bridge_failure_ = false;
+  bool logged_bridge_dump_ = false;
+
+  // Last swap dimensions seen (target sizing between swaps).
+  uint32_t last_swap_width_ = 0;
+  uint32_t last_swap_height_ = 0;
+
+  // Persistent driver pipeline cache.
+  VkPipelineCache pipeline_cache_ = VK_NULL_HANDLE;
+  bool pipeline_cache_dirty_ = false;
+  std::filesystem::path pipeline_cache_path_;
+  std::vector<uint8_t> pipeline_cache_initial_data_;
+};
+
+}  // namespace vulkan
+}  // namespace rex::graphics
