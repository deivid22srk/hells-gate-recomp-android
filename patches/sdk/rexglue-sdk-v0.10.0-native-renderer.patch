             frontbuffer_format == xenos::TextureFormat::k_2_10_10_10 ||
             frontbuffer_format == xenos::TextureFormat::k_2_10_10_10_AS_16_16_16_16;
+
+#ifdef REXGPU_NATIVE_FRAME_RENDERER
+        // ARM-native frame renderer (rexgpu-native plugin): the frame's main
+        // passes were already rendered natively - present the native frame
+        // directly into the guest output (the emulated frontbuffer resolve +
+        // gamma/FXAA chain is skipped, mirroring the Skate 3 Mobile native
+        // renderer's takeover of the refresh callback).
+        if (native_frame_renderer_) {
