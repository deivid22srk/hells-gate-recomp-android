+# rexgpu-native: ARM Android-first GPU plugin (hells-gate-recomp-android).
+# Compiles the same guest-facing Xenos emulation core as rexgpu-xenos (PM4
+# command processing, register files, ucode translation - the correctness
+# backbone) with the host-side rendering path re-tuned for mobile via
+# REXGPU_NATIVE compile-time switches:
+#   - persistent driver-level VkPipelineCache across runs
+#     (native/native_pipeline_cache.cpp) - removes the per-run driver
+#     pipeline recompilation storm that dominates frame time on
+#     big.LITTLE SoCs (measured 100-250 ms per pipeline on a Cortex-A73);
+#   - BCn textures kept compressed when the driver can sample them
+#     (nearest filtering instead of the 4x memory/upload decompress
+#     fallback).
+# Loaded with --gpu_plugin=native. Never linked by consumers; staged next to
+# the executable / into the APK like rexgpu-xenos.
+if(REXGLUE_USE_VULKAN)
+    # The native plugin ships its own entry points
+    # (native/plugin_main_native.cpp: rex_gpu_abi_version / rex_gpu_create).
+    # plugin_main.cpp - the xenos entry - must NOT be compiled into this
+    # target: both define the same C symbols and the .so would fail to link
+    # with duplicate-symbol errors.
+    set(REXGPU_NATIVE_SOURCES ${REXGPU_XENOS_SOURCES})
+    list(REMOVE_ITEM REXGPU_NATIVE_SOURCES plugin_main.cpp)
+    set(REXGPU_NATIVE_EXTRA_SOURCES
+        native/native_pipeline_cache.cpp
+        native/plugin_main_native.cpp
+    )
+    add_library(rexgpu-native SHARED ${REXGPU_NATIVE_SOURCES} ${REXGPU_NATIVE_EXTRA_SOURCES})
+    add_library(rex::gpu-native ALIAS rexgpu-native)
+
+    set_target_properties(rexgpu-native PROPERTIES
+        EXPORT_NAME gpu-native
+        CXX_VISIBILITY_PRESET hidden
+        VISIBILITY_INLINES_HIDDEN ON
+    )
+
+    target_compile_definitions(rexgpu-native PRIVATE REXGPU_NATIVE=1)
+
+    target_include_directories(rexgpu-native PRIVATE
+        ${REXGLUE_ROOT}/thirdparty/renderdoc
+        ${REXGLUE_ROOT}  # For thirdparty/dxbc/DXBCChecksum.h include
+    )
+
+    target_compile_options(rexgpu-native PRIVATE -Wno-unused-variable)
+
+    rex_target_pch(rexgpu-native
+        <mutex>
+        <unordered_map>
+        <rex/math.h>
+        <rex/memory.h>
+        <rex/thread/mutex.h>
+        <rex/system/xmemory.h>
+        <rex/graphics/xenos.h>
+        <rex/graphics/registers.h>
+        <rex/graphics/format/ucode.h>
+        <rex/graphics/pipeline/shader/shader.h>
+    )
+
+    # Everything PRIVATE: the plugin has no consumers. Never link the OBJECT
+    # libraries (rexcore/rexui) here; rexruntime already contains those
+    # objects and relinking them would duplicate global state.
+    target_link_libraries(rexgpu-native PRIVATE
+        rexruntime
+        xxHash::xxhash
+    )
+
+    target_link_libraries(rexgpu-native PRIVATE
+        Vulkan::Headers
+        glslang::SPIRV
+        GPUOpen::VulkanMemoryAllocator
+        glslang
+        MachineIndependent
+        GenericCodeGen
+        OSDependent
+        OGLCompiler
+    )
+endif()
diff -ruN a/src/graphics/native/native_pipeline_cache.cpp b/src/graphics/native/native_pipeline_cache.cpp
--- a/src/graphics/native/native_pipeline_cache.cpp	1970-01-01 00:00:00.000000000 +0000
+++ b/src/graphics/native/native_pipeline_cache.cpp	2026-09-04 15:27:42.534400271 +0000
@@ -0,0 +1,420 @@
+/**
+ * @file        graphics/native/native_pipeline_cache.cpp
+ * @brief       Persistent driver-level Vulkan pipeline cache implementation.
+ *
+ * @copyright   Copyright (c) 2026 hells-gate-recomp-android contributors
+ * @license     BSD 3-Clause License
+ */
+
+#include <rex/graphics/native/native_pipeline_cache.h>
+
+#include <chrono>
+#include <cstdio>
+#include <cstring>
+#include <fstream>
+#include <vector>
+
+#include <rex/cvar.h>
+#include <rex/filesystem.h>
+#include <rex/logging.h>
+
+#if REXGPU_NATIVE
+
+namespace rex::graphics::vulkan::native {
+
+namespace {
+
+REXCVAR_DEFINE_BOOL(native_persistent_pipeline_cache, true, "GPU/Native",
+                    "Persist the driver-level Vulkan pipeline cache to disk between runs "
+                    "(rexgpu-native ARM renderer)")
+    .lifecycle(rex::cvar::Lifecycle::kInitOnly);
+
+REXCVAR_DEFINE_INT32(native_pipeline_cache_max_mb, 48, "GPU/Native",
+                     "Maximum size of the persisted driver pipeline cache blob (MB)")
+    .range(4, 256)
+    .lifecycle(rex::cvar::Lifecycle::kInitOnly);
+
+REXCVAR_DEFINE_INT32(native_pipeline_cache_save_interval_s, 30, "GPU/Native",
+                     "Interval between periodic pipeline cache saves while the game is "
+                     "creating new pipelines (seconds, 0 disables periodic saves)")
+    .range(0, 600)
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+
+// On-disk blob layout:
+//   [BlobHeader][VkPipelineCacheData as returned by vkGetPipelineCacheData]
+// The header carries the physical device's pipelineCacheUUID: the driver
+// guarantees the UUID changes whenever the cache format (or driver) changes,
+// which is exactly the invalidation key required here.
+struct BlobHeader {
+  uint32_t magic;             // 'RVPC'
+  uint32_t version;           // kBlobVersion
+  uint32_t header_size;       // sizeof(BlobHeader) - guards future edits
+  uint32_t blob_size;         // payload bytes following the header
+  uint8_t pipeline_cache_uuid[VK_UUID_SIZE];
+  uint32_t vendor_id;
+  uint32_t device_id;
+  uint32_t driver_version;
+  uint32_t api_version;
+};
+static_assert(sizeof(BlobHeader) == 48, "BlobHeader layout is part of the format");
+
+constexpr uint32_t kBlobMagic = 0x52564843u;  // 'RVPC' (little-endian on disk)
+constexpr uint32_t kBlobVersion = 1;
+
+int64_t NowMonotonicMs() {
+  return int64_t(
+      std::chrono::duration_cast<std::chrono::milliseconds>(
+          std::chrono::steady_clock::now().time_since_epoch())
+          .count());
+}
+
+// Device-level entry points, resolved once per VkDevice. The loader-level
+// entry points (device proc addr, physical device properties) are injected
+// by the caller from the SDK's VulkanInstance dispatch table - this library
+// does not link libvulkan, so referencing those symbols directly would fail
+// to link (undefined vkGetDeviceProcAddr / vkGetPhysicalDeviceProperties).
+struct DeviceFunctions {
+  PFN_vkCreatePipelineCache create_pipeline_cache = nullptr;
+  PFN_vkDestroyPipelineCache destroy_pipeline_cache = nullptr;
+  PFN_vkMergePipelineCaches merge_pipeline_caches = nullptr;
+  PFN_vkGetPipelineCacheData get_pipeline_cache_data = nullptr;
+
+  explicit DeviceFunctions(VkDevice device, PFN_vkGetDeviceProcAddr get_device_proc_addr) {
+    if (!get_device_proc_addr) {
+      return;
+    }
+    auto get = [device, get_device_proc_addr](const char* name) {
+      return get_device_proc_addr(device, name);
+    };
+    create_pipeline_cache =
+        reinterpret_cast<PFN_vkCreatePipelineCache>(get("vkCreatePipelineCache"));
+    destroy_pipeline_cache =
+        reinterpret_cast<PFN_vkDestroyPipelineCache>(get("vkDestroyPipelineCache"));
+    merge_pipeline_caches = reinterpret_cast<PFN_vkMergePipelineCaches>(get("vkMergePipelineCaches"));
+    get_pipeline_cache_data =
+        reinterpret_cast<PFN_vkGetPipelineCacheData>(get("vkGetPipelineCacheData"));
+  }
+};
+
+PersistentPipelineCache* g_persistent_pipeline_cache = nullptr;
+
+}  // namespace
+
+PersistentPipelineCache::~PersistentPipelineCache() {
+  // Deliberately does NOT issue Vulkan calls: the destructor may run after
+  // the VkDevice is gone (hard process exit). Liveness-critical saves happen
+  // through ShutdownPersistentPipelineCache() (graceful path, device alive)
+  // and the periodic save hook (bounds data loss on hard exits).
+  DestroyShards();
+  if (g_persistent_pipeline_cache == this) {
+    g_persistent_pipeline_cache = nullptr;
+  }
+}
+
+void PersistentPipelineCache::Initialize(VkPhysicalDevice physical_device, VkDevice device,
+                                         const std::filesystem::path& blob_path,
+                                         const LoaderFunctions& loader_functions) {
+  if (device_ != VK_NULL_HANDLE) {
+    return;
+  }
+  physical_device_ = physical_device;
+  device_ = device;
+  blob_path_ = blob_path;
+  max_blob_bytes_ = uint64_t(REXCVAR_GET(native_pipeline_cache_max_mb)) * 1024ull * 1024ull;
+
+  if (!loader_functions.vkGetDeviceProcAddr || !loader_functions.vkGetPhysicalDeviceProperties) {
+    REXGPU_WARN("NativePipelineCache: loader function pointers unavailable, disabled");
+    device_ = VK_NULL_HANDLE;
+    return;
+  }
+  physical_device_properties_fn_ = loader_functions.vkGetPhysicalDeviceProperties;
+  get_device_proc_addr_fn_ = loader_functions.vkGetDeviceProcAddr;
+
+  VkPhysicalDeviceProperties properties;
+  physical_device_properties_fn_(physical_device_, &properties);
+  const DeviceFunctions dfn(device_, get_device_proc_addr_fn_);
+
+  // Read + validate the previous run's blob (if any).
+  std::vector<uint8_t> seed;
+  std::ifstream blob(blob_path_, std::ios::binary);
+  if (blob) {
+    BlobHeader header{};
+    if (blob.read(reinterpret_cast<char*>(&header), sizeof(header)) &&
+        header.magic == kBlobMagic && header.version == kBlobVersion &&
+        header.header_size == sizeof(BlobHeader) &&
+        std::memcmp(header.pipeline_cache_uuid, properties.pipelineCacheUUID, VK_UUID_SIZE) == 0 &&
+        header.blob_size > 0 && header.blob_size <= max_blob_bytes_) {
+      seed.resize(header.blob_size);
+      if (!blob.read(reinterpret_cast<char*>(seed.data()), std::streamsize(seed.size()))) {
+        seed.clear();
+      }
+    }
+    blob.close();
+  }
+
+  shards_ = std::make_unique<Shard[]>(kShardCount);
+  uint32_t created = 0;
+  for (uint32_t i = 0; i < kShardCount; ++i) {
+    VkPipelineCacheCreateInfo create_info{};
+    create_info.sType = VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO;
+    create_info.initialDataSize = seed.size();
+    create_info.pInitialData = seed.empty() ? nullptr : seed.data();
+    if (dfn.create_pipeline_cache &&
+        dfn.create_pipeline_cache(device_, &create_info, nullptr, &shards_[i].cache) ==
+            VK_SUCCESS) {
+      ++created;
+    } else {
+      shards_[i].cache = VK_NULL_HANDLE;
+    }
+  }
+  last_save_monotonic_ms_.store(NowMonotonicMs(), std::memory_order_relaxed);
+  dirty_.store(false, std::memory_order_release);
+  poisoned_.store(false, std::memory_order_release);
+
+  REXGPU_INFO(
+      "NativePipelineCache: {} persistent VkPipelineCache shards created at {} (seed {} bytes, "
+      "uuid {:02x}{:02x}{:02x}{:02x}..., max {} MB)",
+      created, rex::path_to_utf8(blob_path_), seed.size(), properties.pipelineCacheUUID[0],
+      properties.pipelineCacheUUID[1], properties.pipelineCacheUUID[2],
+      properties.pipelineCacheUUID[3], REXCVAR_GET(native_pipeline_cache_max_mb));
+
+  if (created == 0) {
+    // Nothing usable - disable silently (the plugin keeps working without it).
+    DestroyShards();
+    device_ = VK_NULL_HANDLE;
+    return;
+  }
+  g_persistent_pipeline_cache = this;
+}
+
+PersistentPipelineCache::CreationSlot PersistentPipelineCache::BeginCreation() {
+  if (device_ == VK_NULL_HANDLE) {
+    return {};
+  }
+  const uint32_t shard = next_shard_.fetch_add(1, std::memory_order_relaxed) % kShardCount;
+  VkPipelineCache cache = shards_[shard].cache;
+  if (cache == VK_NULL_HANDLE) {
+    return {};
+  }
+  return CreationSlot(this, shard, cache, std::unique_lock<std::mutex>(shards_[shard].mutex));
+}
+
+void PersistentPipelineCache::CreationSlot::Release() {
+  if (lock_.owns_lock()) {
+    lock_.unlock();
+  }
+  cache_ = nullptr;
+  cache_handle_ = VK_NULL_HANDLE;
+}
+
+void PersistentPipelineCache::CreationSlot::MarkDirty() {
+  if (cache_) {
+    cache_->dirty_.store(true, std::memory_order_release);
+  }
+}
+
+void PersistentPipelineCache::CreationSlot::Poison() {
+  if (cache_) {
+    cache_->poisoned_.store(true, std::memory_order_release);
+  }
+}
+
+void PersistentPipelineCache::Save(bool wait_for_busy) {
+  if (device_ == VK_NULL_HANDLE || !shards_) {
+    return;
+  }
+  if (!wait_for_busy && !dirty_.load(std::memory_order_acquire)) {
+    return;
+  }
+  if (poisoned_.load(std::memory_order_acquire)) {
+    // The driver rejected cache-backed creation earlier this run; drop the
+    // blob instead of persisting data it cannot consume.
+    std::error_code ec;
+    std::filesystem::remove(blob_path_, ec);
+    dirty_.store(false, std::memory_order_release);
+    REXGPU_WARN("NativePipelineCache: cache poisoned this run, blob removed");
+    return;
+  }
+
+  const DeviceFunctions dfn(device_, get_device_proc_addr_fn_);
+
+  // Merge every unlocked shard into shard 0. Busy shards are skipped (unless
+  // shutting down, where all creation threads are already joined) - their
+  // pipelines are picked up by a later save.
+  std::vector<VkPipelineCache> mergeable;
+  mergeable.reserve(kShardCount);
+  for (uint32_t i = 1; i < kShardCount; ++i) {
+    if (shards_[i].cache == VK_NULL_HANDLE) {
+      continue;
+    }
+    std::unique_lock<std::mutex> lock(shards_[i].mutex, std::try_to_lock);
+    if (wait_for_busy && !lock.owns_lock()) {
+      lock.lock();
+    }
+    if (lock.owns_lock() && shards_[i].cache != VK_NULL_HANDLE) {
+      mergeable.push_back(shards_[i].cache);
+    }
+  }
+  if (!mergeable.empty() && shards_[0].cache != VK_NULL_HANDLE) {
+    std::lock_guard<std::mutex> lock0(shards_[0].mutex);
+    if (!dfn.merge_pipeline_caches ||
+        dfn.merge_pipeline_caches(device_, shards_[0].cache, uint32_t(mergeable.size()),
+                                  mergeable.data()) != VK_SUCCESS) {
+      REXGPU_WARN("NativePipelineCache: vkMergePipelineCaches failed, saving shard 0 only");
+    }
+  }
+  if (shards_[0].cache == VK_NULL_HANDLE) {
+    return;
+  }
+
+  // Retrieve shard 0's data (locked; the GPU thread / shutdown path is the
+  // only caller, and creation workers never target shard 0 for long because
+  // of the round-robin).
+  std::vector<uint8_t> data;
+  {
+    std::lock_guard<std::mutex> lock0(shards_[0].mutex);
+    if (!dfn.get_pipeline_cache_data) {
+      return;
+    }
+    size_t data_size = 0;
+    if (dfn.get_pipeline_cache_data(device_, shards_[0].cache, &data_size, nullptr) != VK_SUCCESS ||
+        data_size == 0) {
+      return;
+    }
+    if (data_size > max_blob_bytes_) {
+      // A truncated blob would be rejected by the driver as corrupt - skip
+      // the save instead and keep the previous (smaller) blob on disk.
+      REXGPU_WARN(
+          "NativePipelineCache: cache data {} bytes exceeds the {} MB cap, skipping the save "
+          "(raise native_pipeline_cache_max_mb if this persists)",
+          data_size, REXCVAR_GET(native_pipeline_cache_max_mb));
+      last_save_monotonic_ms_.store(NowMonotonicMs(), std::memory_order_relaxed);
+      return;
+    }
+    data.resize(data_size);
+    if (dfn.get_pipeline_cache_data(device_, shards_[0].cache, &data_size, data.data()) !=
+            VK_SUCCESS ||
+        data_size == 0) {
+      return;
+    }
+    data.resize(data_size);
+  }
+
+  // Atomic-ish write: tmp file + rename, so a crash mid-write never
+  // corrupts the previous run's cache.
+  const std::filesystem::path tmp_path = blob_path_.string() + ".tmp";
+  {
+    std::error_code ec;
+    std::filesystem::create_directories(blob_path_.parent_path(), ec);
+    std::ofstream out(tmp_path, std::ios::binary | std::ios::trunc);
+    if (!out) {
+      REXGPU_WARN("NativePipelineCache: failed to open {} for writing",
+                  rex::path_to_utf8(tmp_path));
+      return;
+    }
+    VkPhysicalDeviceProperties properties;
+    physical_device_properties_fn_(physical_device_, &properties);
+    BlobHeader header{};
+    header.magic = kBlobMagic;
+    header.version = kBlobVersion;
+    header.header_size = sizeof(BlobHeader);
+    header.blob_size = uint32_t(data.size());
+    std::memcpy(header.pipeline_cache_uuid, properties.pipelineCacheUUID, VK_UUID_SIZE);
+    header.vendor_id = properties.vendorID;
+    header.device_id = properties.deviceID;
+    header.driver_version = properties.driverVersion;
+    header.api_version = properties.apiVersion;
+    out.write(reinterpret_cast<const char*>(&header), sizeof(header));
+    if (!data.empty()) {
+      out.write(reinterpret_cast<const char*>(data.data()), std::streamsize(data.size()));
+    }
+    out.close();
+    if (!out) {
+      std::filesystem::remove(tmp_path, ec);
+      REXGPU_WARN("NativePipelineCache: failed to write the pipeline cache blob");
+      return;
+    }
+    std::filesystem::rename(tmp_path, blob_path_, ec);
+    if (ec) {
+      std::filesystem::remove(tmp_path, ec);
+      REXGPU_WARN("NativePipelineCache: failed to commit the pipeline cache blob");
+      return;
+    }
+  }
+
+  dirty_.store(false, std::memory_order_release);
+  last_save_monotonic_ms_.store(NowMonotonicMs(), std::memory_order_relaxed);
+  REXGPU_INFO("NativePipelineCache: saved {} bytes to {}", data.size(),
+              rex::path_to_utf8(blob_path_));
+}
+
+void PersistentPipelineCache::DestroyShards() {
+  if (device_ != VK_NULL_HANDLE && shards_ && get_device_proc_addr_fn_) {
+    const DeviceFunctions dfn(device_, get_device_proc_addr_fn_);
+    for (uint32_t i = 0; i < kShardCount; ++i) {
+      if (shards_[i].cache != VK_NULL_HANDLE && dfn.destroy_pipeline_cache) {
+        dfn.destroy_pipeline_cache(device_, shards_[i].cache, nullptr);
+        shards_[i].cache = VK_NULL_HANDLE;
+      }
+    }
+  }
+  shards_.reset();
+}
+
+void PersistentPipelineCache::Shutdown() {
+  if (device_ == VK_NULL_HANDLE) {
+    return;
+  }
+  Save(true);
+  DestroyShards();
+  device_ = VK_NULL_HANDLE;
+  if (g_persistent_pipeline_cache == this) {
+    g_persistent_pipeline_cache = nullptr;
+  }
+}
+
+// --- Process-wide accessors -------------------------------------------------
+
+void InitializePersistentPipelineCache(VkPhysicalDevice physical_device, VkDevice device,
+                                       const std::filesystem::path& blob_path,
+                                       const LoaderFunctions& loader_functions) {
+  if (!REXCVAR_GET(native_persistent_pipeline_cache)) {
+    REXGPU_INFO("NativePipelineCache: disabled by cvar");
+    return;
+  }
+  static PersistentPipelineCache pool;
+  pool.Initialize(physical_device, device, blob_path, loader_functions);
+}
+
+PersistentPipelineCache* GetPersistentPipelineCache() { return g_persistent_pipeline_cache; }
+
+void PersistentPipelineCache::MaybeSavePeriodic() {
+  const int32_t interval_s = REXCVAR_GET(native_pipeline_cache_save_interval_s);
+  if (interval_s <= 0 || !dirty_.load(std::memory_order_acquire)) {
+    return;
+  }
+  const int64_t now_ms = NowMonotonicMs();
+  const int64_t last_ms = last_save_monotonic_ms_.load(std::memory_order_relaxed);
+  if (now_ms - last_ms < int64_t(interval_s) * 1000) {
+    return;
+  }
+  Save(false);
+}
+
+void MaybeSavePersistentPipelineCachePeriodic() {
+  PersistentPipelineCache* cache = g_persistent_pipeline_cache;
+  if (cache) {
+    cache->MaybeSavePeriodic();
+  }
+}
+
+void ShutdownPersistentPipelineCache() {
+  PersistentPipelineCache* cache = g_persistent_pipeline_cache;
+  if (cache) {
+    cache->Shutdown();
+  }
+}
+
+}  // namespace rex::graphics::vulkan::native
+
+#endif  // REXGPU_NATIVE
