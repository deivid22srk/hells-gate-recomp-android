diff --git a/include/rex/graphics/vulkan/native_frame_renderer.h b/include/rex/graphics/vulkan/native_frame_renderer.h
new file mode 100644
index 0000000..67220a2
--- /dev/null
+++ b/include/rex/graphics/vulkan/native_frame_renderer.h
@@ -0,0 +1,158 @@
+/**
+ * @file        vulkan/native_frame_renderer.h
+ * @brief       ARM-native frame renderer for the Vulkan command processor
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ *
+ * @remarks     Skate 3 Mobile-style native rendering for the recomp port:
+ *              the game's draws still arrive through the Xenos command
+ *              processor (PM4 parsing, fences, queries, memexport and guest
+ *              shader translation stay intact), but the MAIN-PASS geometry is
+ *              rendered directly into a dedicated Vulkan color + depth target
+ *              presented to the host at swap time, bypassing the EDRAM render
+ *              target emulation, the resolve chains and the guest post-
+ *              process passes entirely (those are suppressed, exactly like
+ *              the Skate 3 port suppresses emulated draws while its native
+ *              renderer owns the frame).
+ *
+ *              Per frame:
+ *               - the first main-pass draw clears the native targets, later
+ *                 draws load them (single in-order scene pass);
+ *               - draws outside the main surface (render-to-texture, post
+ *                 chains, shadow maps at smaller pitches) are suppressed;
+ *               - memexport draws still run on the emulated path for their
+ *                 memory side effects;
+ *               - at swap the native color target is blitted into the
+ *                 presenter's guest output image (the gamma/FXAA chain is
+ *                 skipped; the presenter paints the image directly).
+ */
+
+#pragma once
+
+#include <cstdint>
+#include <filesystem>
+#include <unordered_map>
+#include <vector>
+
+#include <rex/graphics/primitive_processor.h>
+#include <rex/graphics/registers.h>
+#include <rex/graphics/vulkan/pipeline_cache.h>
+#include <rex/ui/vulkan/api.h>
+
+namespace rex::graphics {
+
+class RegisterFile;
+
+namespace vulkan {
+
+class VulkanCommandProcessor;
+class VulkanRenderTargetCache;
+
+class NativeFrameRenderer {
+ public:
+  // What IssueDraw should do with the current draw.
+  enum class DrawRoute {
+    // Run the full emulated path (render target cache + pipeline cache).
+    kEmulated,
+    // Suppress entirely (draw would target a non-main surface that the
+    // native frame does not consume).
+    kSkip,
+    // Render through the native frame targets.
+    kNative,
+  };
+
+  explicit NativeFrameRenderer(VulkanCommandProcessor& command_processor);
+  ~NativeFrameRenderer();
+
+  bool Initialize();
+  void Shutdown();
+
+  // Persistent driver pipeline cache (called by the command processor when
+  // the title's shader storage is initialized).
+  bool InitializePipelineCache(const std::filesystem::path& cache_root, uint32_t title_id);
+  void ShutdownPipelineCache();
+  void SavePipelineCache();
+
+  // Route the draw currently described by the command processor's register
+  // file. Called from IssueDraw after the shader/memexport analysis.
+  DrawRoute RouteDraw(bool memexport_writes_possible, bool is_rasterization_done);
+
+  // Native pipeline for the current state. Returns false when the draw
+  // cannot be served natively and must fall back (caller routes it to
+  // emulated or drops it).
+  bool GetCurrentPipeline(
+      VulkanShader::VulkanTranslation* vertex_shader,
+      VulkanShader::VulkanTranslation* pixel_shader,
+      const PrimitiveProcessor::ProcessingResult& primitive_processing_result,
+      reg::RB_DEPTHCONTROL normalized_depth_control, uint32_t normalized_color_mask,
+      VkPipeline& pipeline_out,
+      const VulkanPipelineCache::PipelineLayoutProvider*& pipeline_layout_out);
+
+  // Lazily creates the frame targets for the current video mode and enters
+  // the native render pass (ending any pass opened by the emulated path for
+  // memexport draws). Clears on the first native draw of the frame.
+  bool BeginFrameDraw();
+
+  // Called at the guest frame boundary (swap packet). Presents the native
+  // frame content into the presenter's guest output image. Returns false
+  // when the frame had no native content (the caller then falls back to the
+  // emulated presentation path).
+  bool PresentFrame(VkImage guest_output_image, uint32_t guest_output_width,
+                    uint32_t guest_output_height);
+
+  uint32_t frame_draw_count() const { return frame_draw_count_; }
+
+  // Marks that one native draw has been recorded into the current frame.
+  void RecordNativeDraw() { ++frame_draw_count_; }
+
+  void RequestShutdown() { shutdown_requested_ = true; }
+
+ private:
+  struct FrameTargets {
+    VkImage color = VK_NULL_HANDLE;
+    VkDeviceMemory color_memory = VK_NULL_HANDLE;
+    VkImageView color_view = VK_NULL_HANDLE;
+    VkImage depth = VK_NULL_HANDLE;
+    VkDeviceMemory depth_memory = VK_NULL_HANDLE;
+    VkImageView depth_view = VK_NULL_HANDLE;
+    VkFormat color_format = VK_FORMAT_R8G8B8A8_UNORM;
+    VkFormat depth_format = VK_FORMAT_D32_SFLOAT_S8_UINT;
+    uint32_t width = 0;
+    uint32_t height = 0;
+  };
+
+  bool EnsureFrameTargets(uint32_t width, uint32_t height);
+  void DestroyFrameTargets();
+  bool EnsureRenderPass(VkFormat color_format, VkFormat depth_format);
+  bool EnsureFramebuffer(uint32_t width, uint32_t height);
+
+  VulkanCommandProcessor& command_processor_;
+
+  bool initialized_ = false;
+  bool shutdown_requested_ = false;
+
+  FrameTargets targets_;
+  VkRenderPass render_pass_ = VK_NULL_HANDLE;
+  VkFramebuffer framebuffer_ = VK_NULL_HANDLE;
+  VkFormat render_pass_color_format_ = VK_FORMAT_UNDEFINED;
+  VkFormat render_pass_depth_format_ = VK_FORMAT_UNDEFINED;
+  uint32_t framebuffer_width_ = 0;
+  uint32_t framebuffer_height_ = 0;
+  bool pass_open_ = false;
+  bool frame_cleared_ = false;
+  uint32_t frame_draw_count_ = 0;
+
+  // Last swap dimensions seen (target sizing between swaps).
+  uint32_t last_swap_width_ = 0;
+  uint32_t last_swap_height_ = 0;
+
+  // Persistent driver pipeline cache.
+  VkPipelineCache pipeline_cache_ = VK_NULL_HANDLE;
+  bool pipeline_cache_dirty_ = false;
+  std::filesystem::path pipeline_cache_path_;
+  std::vector<uint8_t> pipeline_cache_initial_data_;
+};
+
+}  // namespace vulkan
+}  // namespace rex::graphics
