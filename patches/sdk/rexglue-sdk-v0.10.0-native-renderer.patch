+bool VulkanPipelineCache::ConfigurePipelineForNativePass(
+    VulkanShader::VulkanTranslation* vertex_shader, VulkanShader::VulkanTranslation* pixel_shader,
+    const PrimitiveProcessor::ProcessingResult& primitive_processing_result,
+    reg::RB_DEPTHCONTROL normalized_depth_control, uint32_t normalized_color_mask,
+    VulkanRenderTargetCache::RenderPassKey render_pass_key, VkPipelineCache pipeline_cache,
+    VkPipeline& pipeline_out, const PipelineLayoutProvider*& pipeline_layout_out) {
+  pipeline_out = VK_NULL_HANDLE;
+  pipeline_layout_out = nullptr;
+
+  // Native frame renderer path (rexgpu-native plugin). Shares the full
+  // description machinery with the emulated ConfigurePipeline, but:
+  //  - the pipeline map is separate (native_pipelines_) so the native
+  //    renderer's state transitions never disturb the emulated cache;
+  //  - pipelines are created synchronously (no placeholder frame skipping on
+  //    the critical scene pass) and through the persistent driver
+  //    VkPipelineCache for the warm start;
+  //  - the render pass used at creation time is the render target cache's
+  //    pass for the same attachment FORMAT signature as the native pass
+  //    (format compatibility is the only Vulkan requirement for pipelines
+  //    used with a different render pass object; the native pass keeps its
+  //    own load/store/layout behavior).
+  if (!EnsureShadersTranslated(vertex_shader, pixel_shader)) {
+    return false;
+  }
+
+  PipelineDescription description;
+  if (!GetCurrentStateDescription(vertex_shader, pixel_shader, primitive_processing_result,
+                                  normalized_depth_control, normalized_color_mask, render_pass_key,
+                                  description)) {
+    REXGPU_ERROR("VulkanPipelineCache: native GetCurrentStateDescription failed");
+    return false;
+  }
+
+  if (last_native_pipeline_ && last_native_pipeline_->first == description) {
+    VkPipeline last_pipeline = last_native_pipeline_->second.pipeline.load(std::memory_order_acquire);
+    const PipelineLayoutProvider* last_pipeline_layout =
+        last_native_pipeline_->second.pipeline_layout.load(std::memory_order_acquire);
+    if (last_pipeline != VK_NULL_HANDLE && last_pipeline_layout != nullptr) {
+      pipeline_out = last_pipeline;
+      pipeline_layout_out = last_pipeline_layout;
+      return true;
+    }
+  }
+
+  auto it = native_pipelines_.find(description);
+  if (it == native_pipelines_.end()) {
+    // Create the pipeline if not already existing.
+    auto& pipeline = *native_pipelines_.emplace(description, Pipeline()).first;
+    PipelineCreationArguments creation_arguments;
+    if (!TryGetPipelineCreationArgumentsForDescription(description, &pipeline,
+                                                       creation_arguments)) {
+      native_pipelines_.erase(description);
+      return false;
+    }
+    // Synchronous creation through the persistent driver pipeline cache (no
+    // async placeholder skipping on the native scene pass - a missing frame
+    // here would present a stale image, and the persistent cache removes the
+    // creation cost after the first run).
+    native_creation_pipeline_cache_ = pipeline_cache;
+    bool created = EnsurePipelineCreated(creation_arguments);
+    native_creation_pipeline_cache_ = VK_NULL_HANDLE;
+    if (!created) {
+      native_pipelines_.erase(description);
+      return false;
+    }
+    pipeline.second.is_placeholder.store(false, std::memory_order_release);
+    last_native_pipeline_ = &pipeline;
+    pipeline_out = pipeline.second.pipeline.load(std::memory_order_acquire);
+    pipeline_layout_out = pipeline.second.pipeline_layout.load(std::memory_order_acquire);
+    return pipeline_out != VK_NULL_HANDLE && pipeline_layout_out != nullptr;
+  }
+
+  VkPipeline found_pipeline = it->second.pipeline.load(std::memory_order_acquire);
+  const PipelineLayoutProvider* found_pipeline_layout =
+      it->second.pipeline_layout.load(std::memory_order_acquire);
+  if (found_pipeline == VK_NULL_HANDLE || found_pipeline_layout == nullptr) {
+    // Previously inserted but never (or unsuccessfully) created - retry once.
+    PipelineCreationArguments creation_arguments;
+    if (!TryGetPipelineCreationArgumentsForDescription(description, &*it, creation_arguments)) {
+      return false;
+    }
+    native_creation_pipeline_cache_ = pipeline_cache;
+    bool created = EnsurePipelineCreated(creation_arguments);
+    native_creation_pipeline_cache_ = VK_NULL_HANDLE;
+    if (!created) {
+      return false;
+    }
+    it->second.is_placeholder.store(false, std::memory_order_release);
+    found_pipeline = it->second.pipeline.load(std::memory_order_acquire);
+    found_pipeline_layout = it->second.pipeline_layout.load(std::memory_order_acquire);
+  }
+  last_native_pipeline_ = &*it;
+  pipeline_out = found_pipeline;
+  pipeline_layout_out = found_pipeline_layout;
+  return pipeline_out != VK_NULL_HANDLE && pipeline_layout_out != nullptr;
+}
