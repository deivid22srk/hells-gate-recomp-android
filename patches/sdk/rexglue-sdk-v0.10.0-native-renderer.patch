@@ -423,6 +435,16 @@ class VulkanPipelineCache {
 
   std::unordered_map<PipelineDescription, Pipeline, PipelineDescription::Hasher> pipelines_;
 
+  // Pipelines created for the native frame renderer's render pass (rexgpu-
+  // native plugin only; empty otherwise). Separate so enabling/disabling the
+  // native renderer cannot disturb the emulated pipeline cache state.
+  std::unordered_map<PipelineDescription, Pipeline, PipelineDescription::Hasher>
+      native_pipelines_;
+  const std::pair<const PipelineDescription, Pipeline>* last_native_pipeline_ = nullptr;
+  // Set around synchronous native pipeline creation so EnsurePipelineCreated
+  // seeds vkCreateGraphicsPipelines with the persistent driver cache.
+  VkPipelineCache native_creation_pipeline_cache_ = VK_NULL_HANDLE;
+
   // Previously used pipeline, to avoid lookups if the state wasn't changed.
   const std::pair<const PipelineDescription, Pipeline>* last_pipeline_ = nullptr;
   // <Submission index, pipeline>.
