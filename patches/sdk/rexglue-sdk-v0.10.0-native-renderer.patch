+bool VulkanRenderTargetCache::DumpExternalImageToEdram(
+    uint32_t source_base_tiles, uint32_t source_pitch_tiles_at_32bpp,
+    xenos::MsaaSamples source_msaa_samples, bool source_is_depth,
+    uint32_t source_resource_format, size_t descriptor_set_index, VkImage source_image,
+    VkPipelineStageFlags current_stage_mask, VkAccessFlags current_access_mask,
+    VkImageLayout current_layout, VkPipelineStageFlags restored_stage_mask,
+    VkAccessFlags restored_access_mask, VkImageLayout restored_layout, uint32_t height_tiles,
+    uint32_t dest_first_tile, uint32_t dest_pitch_tiles) {
+  assert_true(GetPath() == Path::kHostRenderTargets);
+  RenderTargetKey source_key;
+  source_key.base_tiles = source_base_tiles;
+  source_key.pitch_tiles_at_32bpp = source_pitch_tiles_at_32bpp;
+  source_key.msaa_samples = source_msaa_samples;
+  source_key.is_depth = uint32_t(source_is_depth);
+  source_key.resource_format = source_resource_format;
+  if (source_key.IsEmpty() || !height_tiles || !source_key.pitch_tiles_at_32bpp) {
+    return false;
+  }
+  DumpPipelineKey dump_pipeline_key;
+  dump_pipeline_key.msaa_samples = source_key.msaa_samples;
+  dump_pipeline_key.resource_format = source_key.resource_format;
+  dump_pipeline_key.is_depth = source_key.is_depth;
+  VkPipeline pipeline = GetDumpPipeline(dump_pipeline_key);
+  if (pipeline == VK_NULL_HANDLE) {
+    return false;
+  }
+  bool is_depth = source_key.is_depth;
+  VkDescriptorSet source_descriptor_set =
+      (is_depth ? *descriptor_set_pool_sampled_image_x2_ : *descriptor_set_pool_sampled_image_)
+          .Get(descriptor_set_index);
+
+  VkImageSubresourceRange subresource_range = ui::vulkan::util::InitializeSubresourceRange(
+      is_depth ? (VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT)
+               : VK_IMAGE_ASPECT_COLOR_BIT);
+  // Attachment (or the caller's current) layout -> compute shader read.
+  command_processor_.PushImageMemoryBarrier(
+      source_image, subresource_range, current_stage_mask, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+      current_access_mask, VK_ACCESS_SHADER_READ_BIT, current_layout,
+      VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+  UseEdramBuffer(EdramBufferUsage::kComputeWrite);
+  command_processor_.SubmitBarriers(true);
+
+  VkPipelineLayout pipeline_layout =
+      is_depth ? dump_pipeline_layout_depth_ : dump_pipeline_layout_color_;
+  DeferredCommandBuffer& command_buffer = command_processor_.deferred_command_buffer();
+  command_processor_.BindExternalComputePipeline(pipeline);
+  // Same pipeline layouts for both descriptor sets for all dump pipelines
+  // (binding set 0 once would be enough, bind both for simplicity).
+  command_buffer.CmdVkBindDescriptorSets(VK_PIPELINE_BIND_POINT_COMPUTE, pipeline_layout,
+                                         kDumpDescriptorSetEdram, 1,
+                                         &edram_storage_buffer_descriptor_set_, 0, nullptr);
+  command_buffer.CmdVkBindDescriptorSets(VK_PIPELINE_BIND_POINT_COMPUTE, pipeline_layout,
+                                         kDumpDescriptorSetSource, 1, &source_descriptor_set, 0,
+                                         nullptr);
+  DumpPitches pitches;
+  pitches.dest_pitch = dest_pitch_tiles;
+  pitches.source_pitch = source_key.GetPitchTiles();
+  command_buffer.CmdVkPushConstants(pipeline_layout, VK_SHADER_STAGE_COMPUTE_BIT,
+                                    sizeof(uint32_t) * kDumpPushConstantPitches, sizeof(pitches),
+                                    &pitches);
+  DumpOffsets offsets;
+  offsets.source_base_tiles = source_key.base_tiles;
+  offsets.dispatch_first_tile = dest_first_tile;
+  command_buffer.CmdVkPushConstants(pipeline_layout, VK_SHADER_STAGE_COMPUTE_BIT,
+                                    sizeof(uint32_t) * kDumpPushConstantOffsets, sizeof(offsets),
+                                    &offsets);
+  // The full tile box of the surface (all pitch tiles used for all rows).
+  uint32_t group_count_x =
+      (draw_resolution_scale_x() *
+           (xenos::kEdramTileWidthSamples >> uint32_t(source_key.Is64bpp())) *
+           source_key.GetPitchTiles() +
+       (kDumpSamplesPerGroupX - 1)) /
+      kDumpSamplesPerGroupX;
+  uint32_t group_count_y =
+      (draw_resolution_scale_y() * xenos::kEdramTileHeightSamples * height_tiles +
+       (kDumpSamplesPerGroupY - 1)) /
+      kDumpSamplesPerGroupY;
+  command_buffer.CmdVkDispatch(group_count_x, group_count_y, 1);
+  MarkEdramBufferModified();
+
+  // Restore the layout the caller keeps the image in for its own usage.
+  command_processor_.PushImageMemoryBarrier(
+      source_image, subresource_range, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, restored_stage_mask,
+      VK_ACCESS_SHADER_READ_BIT, restored_access_mask, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL,
+      restored_layout);
+  command_processor_.SubmitBarriers(true);
+  return true;
+}
