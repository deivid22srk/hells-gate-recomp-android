diff -ruN a/include/rex/graphics/native/native_pipeline_cache.h b/include/rex/graphics/native/native_pipeline_cache.h
--- a/include/rex/graphics/native/native_pipeline_cache.h	1970-01-01 00:00:00.000000000 +0000
+++ b/include/rex/graphics/native/native_pipeline_cache.h	2026-09-04 15:27:35.168382592 +0000
@@ -0,0 +1,194 @@
+/**
+ * @file        graphics/native/native_pipeline_cache.h
+ * @brief       Persistent driver-level Vulkan pipeline cache for the
+ *              rexgpu-native ARM Android renderer plugin.
+ *
+ * @remarks     Why this exists (evidence from Android field logs, Adreno 619):
+ *              the Xenos Vulkan backend calls vkCreateGraphicsPipelines with
+ *              VK_NULL_HANDLE as the pipeline cache, so the driver recompiles
+ *              every pipeline from scratch on EVERY application run
+ *              (100-250 ms per pipeline on a Cortex-A73). With 1000+
+ *              unique pipeline variants, that is minutes of GPU-thread /
+ *              worker-thread compile time per session, and frames using
+ *              not-yet-created pipelines are skipped - the perceived result
+ *              is roughly 1 FPS.
+ *
+ *              This component keeps a driver-owned VkPipelineCache alive
+ *              across runs: the driver blob (VkPhysicalDeviceProperties::
+ *              pipelineCacheUUID-keyed) is loaded at startup, seeded into
+ *              sharded VkPipelineCache objects used directly for pipeline
+ *              creation, and merged back to disk periodically and at
+ *              shutdown. On the second and later runs the driver resolves
+ *              previously compiled pipeline binaries from the cache, which
+ *              is what makes the startup prewarm pass finish in seconds
+ *              instead of minutes on mobile SoCs.
+ *
+ *              Concurrency model: pipeline creation happens on multiple
+ *              host threads (startup prewarm workers, async creation
+ *              workers, and the processor thread fallback). Creation is
+ *              spread across kShardCount independent VkPipelineCache objects
+ *              (shard = atomic round-robin), each guarded by its own mutex,
+ *              so unrelated creations proceed in parallel while every cache
+ *              still has single-thread access semantics. Saving merges
+ *              unlocked shards into shard 0 (try-lock based, so a periodic
+ *              save never blocks a compiling worker) and writes the blob
+ *              atomically (tmp file + rename).
+ *
+ * @copyright   Copyright (c) 2026 hells-gate-recomp-android contributors
+ * @license     BSD 3-Clause License
+ */
+
+#ifndef REX_GRAPHICS_NATIVE_NATIVE_PIPELINE_CACHE_H_
+#define REX_GRAPHICS_NATIVE_NATIVE_PIPELINE_CACHE_H_
+
+#include <atomic>
+#include <cstdint>
+#include <filesystem>
+#include <memory>
+#include <mutex>
+
+#include <vulkan/vulkan.h>
+
+namespace rex::graphics::vulkan::native {
+
+// Loader-level entry points the cache needs, injected by the caller (the
+// Vulkan backend) from the SDK's already-loaded VulkanInstance dispatch
+// table. The GPU plugin never links libvulkan directly (the loader is
+// dlopen'ed by the runtime), so these must NOT be referenced as global
+// symbols from this library - doing so fails to link with undefined
+// vkGetDeviceProcAddr / vkGetPhysicalDeviceProperties.
+struct LoaderFunctions {
+  PFN_vkGetDeviceProcAddr vkGetDeviceProcAddr = nullptr;
+  PFN_vkGetPhysicalDeviceProperties vkGetPhysicalDeviceProperties = nullptr;
+};
+
+class PersistentPipelineCache {
+ public:
+  // Four shards: enough to keep the async creation workers and the processor
+  // thread from serializing each other on a 4x big.LITTLE phone, while
+  // bounding the worst-case driver memory used by the seeded cache data.
+  static constexpr uint32_t kShardCount = 4;
+
+  PersistentPipelineCache() = default;
+  ~PersistentPipelineCache();
+
+  PersistentPipelineCache(const PersistentPipelineCache&) = delete;
+  PersistentPipelineCache& operator=(const PersistentPipelineCache&) = delete;
+
+  // Creates the shard caches. Seeds each shard with the on-disk blob when it
+  // exists and its pipelineCacheUUID matches this physical device (a UUID
+  // mismatch means the driver's cache format changed - the blob is ignored
+  // and will be replaced by the next save).
+  void Initialize(VkPhysicalDevice physical_device, VkDevice device,
+                  const std::filesystem::path& blob_path,
+                  const LoaderFunctions& loader_functions);
+
+  // Scoped access to one shard's VkPipelineCache for a single
+  // vkCreateGraphicsPipelines call. Invalid (VK_NULL_HANDLE) when the
+  // persistent cache is disabled or not initialized.
+  class CreationSlot {
+   public:
+    CreationSlot() = default;
+    CreationSlot(PersistentPipelineCache* cache, uint32_t shard, VkPipelineCache cache_handle,
+                 std::unique_lock<std::mutex>&& lock)
+        : cache_(cache), shard_(shard), cache_handle_(cache_handle), lock_(std::move(lock)) {}
+    CreationSlot(CreationSlot&& other) noexcept { MoveFrom(other); }
+    CreationSlot& operator=(CreationSlot&& other) noexcept {
+      if (this != &other) {
+        Release();
+        MoveFrom(other);
+      }
+      return *this;
+    }
+    ~CreationSlot() { Release(); }
+
+    explicit operator bool() const { return cache_handle_ != VK_NULL_HANDLE; }
+    VkPipelineCache cache() const { return cache_handle_; }
+    uint32_t shard() const { return shard_; }
+
+    // Marks the persistent blob as needing a save after a successful creation.
+    void MarkDirty();
+    // Requests that the blob not be persisted (poisoned by a driver rejection).
+    void Poison();
+
+   private:
+    void MoveFrom(CreationSlot& other) {
+      cache_ = other.cache_;
+      shard_ = other.shard_;
+      cache_handle_ = other.cache_handle_;
+      lock_ = std::move(other.lock_);
+      other.cache_ = nullptr;
+      other.shard_ = 0;
+      other.cache_handle_ = VK_NULL_HANDLE;
+    }
+    void Release();
+
+    PersistentPipelineCache* cache_ = nullptr;
+    uint32_t shard_ = 0;
+    VkPipelineCache cache_handle_ = VK_NULL_HANDLE;
+    std::unique_lock<std::mutex> lock_;
+  };
+
+  // Picks a free-ish shard (round-robin) and locks it for one creation call.
+  CreationSlot BeginCreation();
+
+  // Merges shards that are not currently compiling into shard 0 and writes
+  // the blob when the content is dirty. Never blocks on busy shards unless
+  // wait_for_busy is true (used at shutdown, when creation threads are
+  // already joined). Bounded by max_blob_bytes.
+  void Save(bool wait_for_busy);
+
+  // Full teardown: merge everything, save, destroy the shard caches. Must be
+  // called while the VkDevice is still alive (before device destruction) and
+  // after all pipeline creation threads have been joined.
+  void Shutdown();
+
+  // Periodic save entry point (GPU thread): saves when dirty and the interval
+  // has elapsed; cheap no-op otherwise.
+  void MaybeSavePeriodic();
+
+  bool initialized() const { return device_ != VK_NULL_HANDLE; }
+
+ private:
+  struct Shard {
+    std::mutex mutex;
+    VkPipelineCache cache = VK_NULL_HANDLE;
+  };
+
+  void DestroyShards();
+
+  VkPhysicalDevice physical_device_ = VK_NULL_HANDLE;
+  VkDevice device_ = VK_NULL_HANDLE;
+  PFN_vkGetDeviceProcAddr get_device_proc_addr_fn_ = nullptr;
+  PFN_vkGetPhysicalDeviceProperties physical_device_properties_fn_ = nullptr;
+  std::filesystem::path blob_path_;
+  uint64_t max_blob_bytes_ = 0;
+  std::unique_ptr<Shard[]> shards_;
+  std::atomic<uint32_t> next_shard_{0};
+  std::atomic<bool> dirty_{false};
+  std::atomic<bool> poisoned_{false};
+  std::atomic<int64_t> last_save_monotonic_ms_{0};
+};
+
+// --- Process-wide accessors used by the VulkanPipelineCache hooks ----------
+
+// No-op if the native persistent pipeline cache cvar is disabled or this was
+// already initialized (there is exactly one VulkanPipelineCache per process).
+void InitializePersistentPipelineCache(VkPhysicalDevice physical_device, VkDevice device,
+                                       const std::filesystem::path& blob_path,
+                                       const LoaderFunctions& loader_functions);
+
+// Returns the process-wide pool, or nullptr when disabled/uninitialized.
+PersistentPipelineCache* GetPersistentPipelineCache();
+
+// Periodic save hook (called per submission from the GPU thread): saves when
+// dirty and at least the configured interval has elapsed. Cheap when clean.
+void MaybeSavePersistentPipelineCachePeriodic();
+
+// Save + teardown with the VkDevice still alive. Called from
+// VulkanPipelineCache::Shutdown after creation threads are joined.
+void ShutdownPersistentPipelineCache();
+
+}  // namespace rex::graphics::vulkan::native
+
+#endif  // REX_GRAPHICS_NATIVE_NATIVE_PIPELINE_CACHE_H_
