+/**
+ * @file        graphics/native/plugin_main_native.cpp
+ * @brief       rexgpu-native plugin entry points (ARM Android renderer)
+ *
+ * @remarks     rexgpu-native packages the same guest-facing Xenos emulation
+ *              core as rexgpu-xenos (PM4 command processing, register files,
+ *              ucode translation - the correctness backbone any Xenos
+ *              renderer needs) with a host-side rendering architecture
+ *              re-tuned for ARM Android:
+ *                - persistent driver-level VkPipelineCache across runs
+ *                  (native_pipeline_cache.cpp), removing the per-run driver
+ *                  pipeline recompilation storm;
+ *                - BCn texture formats kept in their compressed form when the
+ *                  driver can sample them (nearest filtering instead of the
+ *                  4x memory/upload decompress fallback).
+ *              Selected with --gpu_plugin=native (Android UI toggle).
+ *
+ * @copyright   Copyright (c) 2026 hells-gate-recomp-android contributors
+ * @license     BSD 3-Clause License
+ */
+
+#include <string_view>
+
+#include <rex/logging.h>
+#include <rex/system/gpu_plugin.h>
+
+#if REX_HAS_VULKAN
+#include <rex/graphics/vulkan/graphics_system.h>
+#endif
+
+extern "C" REX_GPU_PLUGIN_EXPORT uint32_t rex_gpu_abi_version(void) {
+  return rex::system::kGpuPluginAbiVersion;
+}
+
+extern "C" REX_GPU_PLUGIN_EXPORT rex::system::IGraphicsSystem* rex_gpu_create(
+    uint32_t abi_version, const rex::system::GpuCreateInfo* info) {
+  if (abi_version != rex::system::kGpuPluginAbiVersion) {
+    REXLOG_ERROR("rexgpu-native: host requested ABI {}, plugin is ABI {}", abi_version,
+                 rex::system::kGpuPluginAbiVersion);
+    return nullptr;
+  }
+  if (!info || info->struct_size < sizeof(rex::system::GpuCreateInfo)) {
+    REXLOG_ERROR("rexgpu-native: invalid GpuCreateInfo");
+    return nullptr;
+  }
+
+  std::string_view backend = info->backend ? info->backend : "any";
+#if REX_HAS_VULKAN
+  if (backend == "any" || backend == "vulkan") {
+    REXLOG_INFO("rexgpu-native: ARM-native Vulkan renderer enabled "
+                "(persistent driver pipeline cache + BCn-preserving texture policy)");
+    return new rex::graphics::vulkan::VulkanGraphicsSystem();
+  }
+#endif
+  REXLOG_ERROR("rexgpu-native: requested backend '{}' is not compiled into this plugin", backend);
+  return nullptr;
+}
